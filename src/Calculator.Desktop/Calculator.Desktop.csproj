<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>CalculatorApp.Desktop</RootNamespace>
    <AssemblyName>Calculator.Desktop</AssemblyName>
    <ApplicationTitle>Calculator</ApplicationTitle>
    <Product>Calculator</Product>
    <Authors>jmacato</Authors>
    <Company>jmacato</Company>
    <Version>1.0.0</Version>
    <ApplicationVersion>1.0.0</ApplicationVersion>
    <ApplicationId>io.github.jmacato.calculator</ApplicationId>

    <RuntimeIdentifiers>win-x64;win-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationManifest>..\Calculator\app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Calculator\Automation\AutomationJsonContext.cs"
             Link="Automation\AutomationJsonContext.cs" />
    <Compile Include="..\Calculator\Automation\AutomationServer.cs"
             Link="Automation\AutomationServer.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Calculator\Calculator.csproj" />
  </ItemGroup>
</Project>
