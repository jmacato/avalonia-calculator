<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="using:FluentAvalonia.UI.Controls"
                    x:CompileBindings="True">

    <Design.PreviewWith>
        <Border Padding="50">
            <StackPanel Spacing="5">
                <ui:WinUiToggleSwitch Content="Button" />
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <Thickness x:Key="ToggleSwitchTopHeaderMargin">0,0,0,4</Thickness>
    <!-- Changed to GridLength -->
    <GridLength x:Key="ToggleSwitchPreContentMargin">10</GridLength>
    <GridLength x:Key="ToggleSwitchPostContentMargin">10</GridLength>
    <!-- Not forced as of v2, but available if still wanted-->
    <x:Double x:Key="ToggleSwitchThemeMinWidth">154</x:Double>

    <ControlTheme x:Key="{x:Type ui:WinUiToggleSwitch}" TargetType="ui:WinUiToggleSwitch">
        <Setter Property="Foreground" Value="{DynamicResource ToggleSwitchContentForeground}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        <Setter Property="KnobTransitions">
            <Transitions>
                <DoubleTransition Easing="0.1,0.9,0.2,1"
                                  Property="Canvas.Left"
                                  Duration="0:0:0.367" />
            </Transitions>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid Background="{TemplateBinding Background}"
                      RowDefinitions="Auto,*">

                    <ContentPresenter x:Name="PART_ContentPresenter"
                                      Grid.Row="0"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      VerticalAlignment="Top"
                                      Margin="{DynamicResource ToggleSwitchTopHeaderMargin}"
                                      RecognizesAccessKey="True"/>

                    <Grid Grid.Row="1"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="{DynamicResource ToggleSwitchPreContentMargin}" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{DynamicResource ToggleSwitchPostContentMargin}" />
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" MaxWidth="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:WinUiBrushBorder x:Name="SwitchAreaGrid"
                                Grid.RowSpan="3"
                                Grid.ColumnSpan="3"
                                TemplatedControl.IsTemplateFocusTarget="True"
                                Margin="0,5"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                TargetBackground="{DynamicResource ToggleSwitchContainerBackground}"
                                TransitionDuration="0"/>

                        <ContentPresenter x:Name="PART_OffContentPresenter"
                                          Grid.RowSpan="3"
                                          Grid.Column="2"
                                          Content="{TemplateBinding OffContent}"
                                          ContentTemplate="{TemplateBinding OffContentTemplate}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>

                        <ContentPresenter x:Name="PART_OnContentPresenter"
                                          Grid.RowSpan="3"
                                          Grid.Column="2"
                                          Content="{TemplateBinding OnContent}"
                                          ContentTemplate="{TemplateBinding OnContentTemplate}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>

                        <ui:WinUiBrushBorder x:Name="OuterBorder"
                                TargetBackground="{DynamicResource ToggleSwitchFillOff}"
                                TargetBorderBrush="{DynamicResource ToggleSwitchStrokeOff}"
                                TransitionDuration="0"
                                Grid.Row="1"
                                Height="20"
                                Width="40"
                                CornerRadius="10"
                                BorderThickness="{DynamicResource ToggleSwitchOuterBorderStrokeThickness}">
                        </ui:WinUiBrushBorder>

                        <Border x:Name="SwitchKnobBounds"
                                Background="{DynamicResource ToggleSwitchFillOn}"
                                BorderBrush="{DynamicResource ToggleSwitchStrokeOn}"
                                Grid.Row="1"
                                Height="20"
                                Width="40"
                                CornerRadius="10"
                                BorderThickness="{DynamicResource ToggleSwitchOnStrokeThickness}">
                        </Border>

                        <Canvas x:Name="PART_SwitchKnob" Grid.Row="1"
                                HorizontalAlignment="Left"
                                Width="20" Height="20">

                            <Grid x:Name="PART_MovingKnobs"
                                  Width="20" Height="20">

                                <Border x:Name="SwitchKnobOn"
                                         Background="{DynamicResource ToggleSwitchKnobFillOn}"
                                         BorderBrush="{DynamicResource ToggleSwitchKnobStrokeOn}"
                                         Width="12"
                                         Height="12"
                                         CornerRadius="7"
                                         HorizontalAlignment="Center"
                                         Margin="0,0,1,0">
                                    <Border.Transitions>
                                        <Transitions>
                                            <DoubleTransition Duration="00:00:00.083" Easing="0,0,0,1" Property="Width" />
                                            <DoubleTransition Duration="00:00:00.083" Easing="0,0,0,1" Property="Height" />
                                        </Transitions>
                                    </Border.Transitions>
                                </Border>

                                <Ellipse x:Name="SwitchKnobOff"
                                         Fill="{DynamicResource ToggleSwitchKnobFillOff}"
                                         Width="12"
                                         Height="12"
                                         HorizontalAlignment="Center"
                                         Margin="-1,0,0,0">
                                    <Ellipse.Transitions>
                                        <Transitions>
                                            <DoubleTransition Duration="00:00:00.083" Easing="0,0,0,1" Property="Width" />
                                            <DoubleTransition Duration="00:00:00.083" Easing="0,0,0,1" Property="Height" />
                                        </Transitions>
                                    </Ellipse.Transitions>
                                </Ellipse>
                            </Grid>
                        </Canvas>
                    </Grid>
                </Grid>
            </ControlTemplate>
        </Setter>


        <Style Selector="^:pointerover">
            <Style Selector="^ /template/ ui|WinUiBrushBorder#OuterBorder">
                <Setter Property="TransitionDuration" Value="00:00:00.083"/>
                <Setter Property="TargetBorderBrush" Value="{DynamicResource ToggleSwitchStrokeOffPointerOver}"/>
                <Setter Property="TargetBackground" Value="{DynamicResource ToggleSwitchFillOffPointerOver}"/>
            </Style>
            <Style Selector="^ /template/ Ellipse#SwitchKnobOff">
                <Setter Property="Fill" Value="{DynamicResource ToggleSwitchKnobFillOffPointerOver}"/>
                <Setter Property="Width" Value="14" />
                <Setter Property="Height" Value="14" />
            </Style>
            <Style Selector="^ /template/ Border#SwitchKnobOn">
                <Setter Property="Background" Value="{DynamicResource ToggleSwitchKnobFillOnPointerOver}"/>
                <Setter Property="Width" Value="14" />
                <Setter Property="Height" Value="14" />
            </Style>
            <Style Selector="^ /template/ Border#SwitchKnobBounds">
                <Setter Property="Background" Value="{DynamicResource ToggleSwitchFillOnPointerOver}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ToggleSwitchStrokeOnPointerOver}"/>
            </Style>
            <Style Selector="^ /template/ ui|WinUiBrushBorder#SwitchAreaGrid">
                <Setter Property="TransitionDuration" Value="00:00:00.083"/>
                <Setter Property="TargetBackground" Value="{DynamicResource ToggleSwitchContainerBackgroundPointerOver}"/>
            </Style>
        </Style>

        <Style Selector="^:pressed">
            <Style Selector="^ /template/ ui|WinUiBrushBorder#OuterBorder">
                <Setter Property="TransitionDuration" Value="00:00:00.083"/>
                <Setter Property="TargetBorderBrush" Value="{DynamicResource ToggleSwitchStrokeOffPressed}"/>
                <Setter Property="TargetBackground" Value="{DynamicResource ToggleSwitchFillOffPressed}"/>
            </Style>
            <Style Selector="^ /template/ Border#SwitchKnobBounds">
                <Setter Property="Background" Value="{DynamicResource ToggleSwitchFillOnPressed}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ToggleSwitchStrokeOnPressed}"/>
            </Style>
            <Style Selector="^ /template/ Ellipse#SwitchKnobOff">
                <Setter Property="Fill" Value="{DynamicResource ToggleSwitchKnobFillOffPressed}"/>
                <Setter Property="Width" Value="17" />
                <Setter Property="Height" Value="14" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Margin" Value="3,0,0,0" />
            </Style>
            <Style Selector="^ /template/ Border#SwitchKnobOn">
                <Setter Property="Background" Value="{DynamicResource ToggleSwitchKnobFillOnPressed}"/>
                <Setter Property="Width" Value="17" />
                <Setter Property="Height" Value="14" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="Margin" Value="0,0,3,0" />
            </Style>
            <Style Selector="^ /template/ ui|WinUiBrushBorder#SwitchAreaGrid">
                <Setter Property="TransitionDuration" Value="00:00:00.083"/>
                <Setter Property="TargetBackground" Value="{DynamicResource ToggleSwitchContainerBackgroundPressed}"/>
            </Style>
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{DynamicResource ToggleSwitchHeaderForegroundDisabled}"/>
            
            <Style Selector="^ /template/ ui|WinUiBrushBorder#OuterBorder">
                <Setter Property="TransitionDuration" Value="00:00:00.083"/>
                <Setter Property="TargetBorderBrush" Value="{DynamicResource ToggleSwitchStrokeOffDisabled}"/>
                <Setter Property="TargetBackground" Value="{DynamicResource ToggleSwitchFillOffDisabled}"/>
            </Style>
            <Style Selector="^ /template/ Ellipse#SwitchKnobOff">
                <Setter Property="Fill" Value="{DynamicResource ToggleSwitchKnobFillOffDisabled}"/>
                <Setter Property="Width" Value="12" />
                <Setter Property="Height" Value="12" />
                <Setter Property="Transitions">
                    <Transitions>
                        <DoubleTransition Duration="00:00:00.250" Easing="0,0,0,1" Property="Width" />
                        <DoubleTransition Duration="00:00:00.250" Easing="0,0,0,1" Property="Height" />
                    </Transitions>
                </Setter>
            </Style>
            <Style Selector="^ /template/ Border#SwitchKnobOn">
                <Setter Property="Background" Value="{DynamicResource ToggleSwitchKnobFillOnDisabled}"/>
                <Setter Property="Width" Value="12" />
                <Setter Property="Height" Value="12" />
                <Setter Property="Transitions">
                    <Transitions>
                        <DoubleTransition Duration="00:00:00.250" Easing="0,0,0,1" Property="Width" />
                        <DoubleTransition Duration="00:00:00.250" Easing="0,0,0,1" Property="Height" />
                    </Transitions>
                </Setter>
            </Style>
            <Style Selector="^ /template/ Border#SwitchKnobBounds">
                <Setter Property="Background" Value="{DynamicResource ToggleSwitchFillOnDisabled}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ToggleSwitchStrokeOnDisabled}"/>
            </Style>
            <Style Selector="^ /template/ ui|WinUiBrushBorder#SwitchAreaGrid">
                <Setter Property="TransitionDuration" Value="00:00:00.083"/>
                <Setter Property="TargetBackground" Value="{DynamicResource ToggleSwitchContainerBackgroundDisabled}"/>
            </Style>
        </Style>


        <Style Selector="^:checked">
            <Style Selector="^ /template/ ContentPresenter#PART_OffContentPresenter">
                <Setter Property="Opacity" Value="0"/>
            </Style>
            <Style Selector="^ /template/ ContentPresenter#PART_OnContentPresenter">
                <Setter Property="Opacity" Value="1"/>
            </Style>
        </Style>

        <Style Selector="^:unchecked">
            <Style Selector="^ /template/ ContentPresenter#PART_OffContentPresenter">
                <Setter Property="Opacity" Value="1"/>
            </Style>

            <Style Selector="^ /template/ ContentPresenter#PART_OnContentPresenter">
                <Setter Property="Opacity" Value="0"/>
            </Style>
        </Style>
    </ControlTheme>
</ResourceDictionary>
