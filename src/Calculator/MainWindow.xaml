<Window x:Class="CalculatorApp.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        Title="Calculator"
        Width="440"
        Height="720"
        MinWidth="320"
        MinHeight="500">
  <Grid x:Name="WindowRoot" RowDefinitions="48,*">
    <Grid x:Name="AppTitleBar"
          Grid.Row="0"
          Height="48"
          chrome:WindowDecorationProperties.ElementRole="TitleBar"
          ColumnDefinitions="48,Auto,*">
      <Button x:Name="AppTitleBarBackButton"
              Grid.Column="0"
              Margin="8"
              Padding="8,0"
              Content="&#x2190;"
              IsVisible="False" />
      <TextBlock x:Name="TitleTextBlock"
                 Grid.Column="1"
                 Text="Calculator"
                 FontSize="14"
                 FontWeight="SemiBold"
                 VerticalAlignment="Center"
                 Margin="4,0,0,0" />
    </Grid>

    <ContentControl x:Name="PageFrame" Grid.Row="1" />
  </Grid>
</Window>
