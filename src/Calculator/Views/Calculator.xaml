<UserControl x:Class="CalculatorApp.Calculator"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:CalculatorApp.Controls"
             xmlns:converters="using:CalculatorApp.Converters"
             xmlns:automation="using:CalculatorApp.ViewModel.Common.Automation"
             xmlns:local="using:CalculatorApp"
             xmlns:utils="using:CalculatorApp.Utils"
             xmlns:vm="using:CalculatorApp.ViewModel"
             xmlns:vmcommon="using:CalculatorApp.ViewModel.Common"
             x:DataType="vm:StandardCalculatorViewModel"
             x:CompileBindings="True"
             Focusable="True"
             KeyDown="OnKeyDown"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded"
             SizeChanged="OnSizeChanged">
  <UserControl.Resources>
    <DataTemplate x:Key="Operand" x:DataType="vmcommon:DisplayExpressionToken">
      <TextBlock Margin="2,0,0,0"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                 Text="{CompiledBinding Token}" />
    </DataTemplate>
    <DataTemplate x:Key="Operator" x:DataType="vmcommon:DisplayExpressionToken">
      <TextBlock Margin="2,0,0,0"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                 Text="{CompiledBinding Token}" />
    </DataTemplate>
    <DataTemplate x:Key="Separator" x:DataType="vmcommon:DisplayExpressionToken">
      <TextBlock Text="{CompiledBinding Token}" />
    </DataTemplate>
    <converters:ExpressionItemTemplateSelector x:Key="ExpressionItemTemplateSelector"
                                               OperandTemplate="{StaticResource Operand}"
                                               OperatorTemplate="{StaticResource Operator}"
                                               SeparatorTemplate="{StaticResource Separator}" />

    <!-- Direct Avalonia translation of Calculator.xaml's copied
         DockPanelTemplate and PivotHeaderItem style. TabControl supplies only
         selection/content plumbing; the visual tree, Calculator's 14px/Normal
         Pivot override, 48px headers, custom foreground states, and 16x3
         selected pipe come from the original. -->
    <ControlTheme x:Key="DockPivotStyle" TargetType="TabControl">
      <Setter Property="Margin" Value="0,-3,0,0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Margin="{TemplateBinding Margin}"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
            <DockPanel>
              <ItemsPresenter x:Name="PART_ItemsPresenter"
                              DockPanel.Dock="Top"
                              ItemsPanel="{TemplateBinding ItemsPanel}" />
              <Panel ClipToBounds="True">
                <ContentPresenter x:Name="PART_SelectedContentHost2"
                                  HorizontalContentAlignment="Stretch"
                                  VerticalContentAlignment="Stretch"
                                  IsVisible="False" />
                <ContentPresenter x:Name="PART_SelectedContentHost"
                                  HorizontalContentAlignment="Stretch"
                                  VerticalContentAlignment="Stretch" />
              </Panel>
            </DockPanel>
          </Border>
        </ControlTemplate>
      </Setter>
    </ControlTheme>

    <ControlTheme x:Key="DockPivotItemStyle" TargetType="TabItem">
      <Setter Property="FontSize" Value="{DynamicResource PivotHeaderItemFontSize}" />
      <Setter Property="FontWeight" Value="{DynamicResource PivotHeaderItemThemeFontWeight}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Height" Value="48" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="Grid"
                  Padding="{TemplateBinding Padding}"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{DynamicResource ControlCornerRadius}">
            <Panel>
              <ContentPresenter x:Name="ContentPresenter"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                FontFamily="{TemplateBinding FontFamily}"
                                FontSize="{TemplateBinding FontSize}"
                                FontWeight="{TemplateBinding FontWeight}"
                                Content="{TemplateBinding Header}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}" />
              <Rectangle x:Name="SelectedPipe"
                         Width="16"
                         Height="3"
                         Margin="0,0,0,2"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Bottom"
                         Fill="{DynamicResource AccentFillColorDefaultBrush}"
                         IsVisible="False"
                         RadiusX="1.5"
                         RadiusY="1.5" />
            </Panel>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:selected /template/ Rectangle#SelectedPipe">
        <Setter Property="IsVisible" Value="True" />
      </Style>
      <Style Selector="^:selected:pointerover /template/ Rectangle#SelectedPipe">
        <Setter Property="Fill" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
      </Style>
      <Style Selector="^:selected:pressed /template/ Rectangle#SelectedPipe">
        <Setter Property="Fill" Value="{DynamicResource AccentFillColorTertiaryBrush}" />
      </Style>
      <Style Selector="^:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      </Style>
      <Style Selector="^:pressed">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
      </Style>
    </ControlTheme>
  </UserControl.Resources>
  <!-- This is the original Calculator.xaml structure translated in place. The
       named rows and columns are driven by the same WinUI VisualState values in
       Calculator.xaml.cs because Avalonia has no AdaptiveTrigger equivalent. -->
  <Grid x:Name="LayoutRoot"
        AutomationProperties.LandmarkType="Main">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="0" MaxWidth="320" />
    </Grid.ColumnDefinitions>

    <Grid x:Name="CalculatorPanel"
          Grid.Column="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="48" />
        <RowDefinition Height="22*" MinHeight="0" />
        <RowDefinition Height="72*" MinHeight="20" />
        <RowDefinition Height="0" MinHeight="0" />
        <RowDefinition Height="32*" MinHeight="0" />
        <RowDefinition Height="308*" MinHeight="0" />
      </Grid.RowDefinitions>

      <controls:OverflowTextBlock x:Name="ExpressionText"
                                  Grid.Row="1"
                                  Margin="6,0"
                                  VerticalAlignment="Bottom"
                                  VerticalContentAlignment="Bottom"
                                  AutomationProperties.AutomationId="CalculatorExpression"
                                  AutomationProperties.Name="{CompiledBinding CalculationExpressionAutomationName}"
                                  Focusable="False"
                                  ItemTemplate="{StaticResource ExpressionItemTemplateSelector}"
                                  ItemsSource="{CompiledBinding ExpressionTokens}"
                                  TokensUpdated="{CompiledBinding AreTokensUpdated}"
                                  IsVisible="{CompiledBinding !IsAlwaysOnTop}" />

      <controls:CalculationResult x:Name="Results"
                                  Grid.Row="2"
                                  HorizontalContentAlignment="Right"
                                  VerticalContentAlignment="Top"
                                  DisplayMargin="0"
                                  IsActive="True"
                                  MinFontSize="12"
                                  MaxFontSize="46"
                                  AutomationProperties.AutomationId="CalculatorResults"
                                  AutomationProperties.LiveSetting="Assertive"
                                  AutomationProperties.Name="{CompiledBinding CalculationResultAutomationName}"
                                  DisplayValue="{CompiledBinding DisplayValue}"
                                  IsInError="{CompiledBinding IsInError}"
                                  IsOperatorCommand="{CompiledBinding IsOperatorCommand}"
                                  IsVisible="{CompiledBinding !IsAlwaysOnTop}">
        <controls:CalculationResult.ContextMenu>
          <ContextMenu>
            <MenuItem Header="{utils:ResourceString Name='copyMenuItem'}"
                      Command="{CompiledBinding CopyCommand}" />
            <MenuItem Header="{utils:ResourceString Name='pasteMenuItem'}"
                      Command="{CompiledBinding PasteCommand}" />
          </ContextMenu>
        </controls:CalculationResult.ContextMenu>
      </controls:CalculationResult>

      <controls:OverflowTextBlock x:Name="AlwaysOnTopResults"
                                  Grid.Row="2"
                                  Margin="6,0"
                                  Classes="alwaysOnTop"
                                  HorizontalContentAlignment="Right"
                                  FontSize="40"
                                  AutomationProperties.AutomationId="CalculatorAlwaysOnTopResults"
                                  AutomationProperties.LiveSetting="Assertive"
                                  AutomationProperties.Name="{CompiledBinding CalculationResultAutomationName}"
                                  DisplayValue="{CompiledBinding DisplayValue}"
                                  IsActive="True"
                                  ScrollButtonsFontSize="28"
                                  ScrollButtonsPlacement="Above"
                                  ScrollButtonsWidth="28"
                                  TokensUpdated="{CompiledBinding AreAlwaysOnTopResultsUpdated}"
                                  IsVisible="{CompiledBinding IsAlwaysOnTop}" />

      <!-- The original Programmer radix display shares this row with the
           Scientific angle controls. -->
      <Grid x:Name="ScientificAngleButtonsHost"
            Grid.Row="3"
            IsEnabled="{CompiledBinding IsScientific}"
            IsVisible="{CompiledBinding IsScientific}" />
      <Grid x:Name="ProgrammerOperatorsHost"
            Grid.Row="3"
            IsEnabled="{CompiledBinding IsProgrammer}"
            IsVisible="{CompiledBinding IsProgrammer}" />

      <!-- The Programmer input-mode/word-size control intentionally shares the
           memory row. The original VisualState hides MC/MR/M+/M- and moves MS. -->
      <Grid x:Name="ProgrammerDisplayPanelHost"
            Grid.Row="4"
            Margin="3,0"
            IsEnabled="{CompiledBinding IsProgrammer}"
            IsVisible="{CompiledBinding IsProgrammer}" />

      <Grid x:Name="MemoryPanel"
            Grid.Row="4"
            Margin="3,0"
            AutomationProperties.Name="{utils:ResourceString Name='MemoryPanel.[using:Windows.UI.Xaml.Automation]AutomationProperties.Name'}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1*" MaxWidth="80" />
          <ColumnDefinition Width="1*" MaxWidth="80" />
          <ColumnDefinition Width="1*" MaxWidth="80" />
          <ColumnDefinition Width="1*" MaxWidth="80" />
          <ColumnDefinition Width="1*" MaxWidth="80" />
          <ColumnDefinition Width="0.01*" MaxWidth="80" />
          <ColumnDefinition Width="1*" MaxWidth="80" />
        </Grid.ColumnDefinitions>

        <controls:CalculatorButton x:Name="ClearMemoryButton"
                                   Classes="symbol"
                                   AutomationProperties.AutomationId="ClearMemoryButton"
                                   AutomationProperties.Name="{utils:ResourceString Name='ClearMemoryButton.[using:Windows.UI.Xaml.Automation]AutomationProperties.Name'}"
                                   Command="{CompiledBinding ClearMemoryCommand}"
                                   Content="&#xF754;" />
        <controls:CalculatorButton x:Name="MemRecall"
                                   Grid.Column="1"
                                   Classes="symbol"
                                   AutomationProperties.AutomationId="MemRecall"
                                   AutomationProperties.Name="{utils:ResourceString Name='MemRecall.[using:Windows.UI.Xaml.Automation]AutomationProperties.Name'}"
                                   Command="{CompiledBinding MemoryItemPressed}"
                                   CommandParameter="{StaticResource Zero}"
                                   Content="&#xF755;" />
        <controls:CalculatorButton x:Name="MemPlus"
                                   Grid.Column="2"
                                   Classes="symbol"
                                   AutomationProperties.AutomationId="MemPlus"
                                   AutomationProperties.Name="{utils:ResourceString Name='MemPlus.[using:Windows.UI.Xaml.Automation]AutomationProperties.Name'}"
                                   Command="{CompiledBinding MemoryAdd}"
                                   CommandParameter="{StaticResource Zero}"
                                   Content="&#xF757;" />
        <controls:CalculatorButton x:Name="MemMinus"
                                   Grid.Column="3"
                                   Classes="symbol"
                                   AutomationProperties.AutomationId="MemMinus"
                                   AutomationProperties.Name="{utils:ResourceString Name='MemMinus.[using:Windows.UI.Xaml.Automation]AutomationProperties.Name'}"
                                   Command="{CompiledBinding MemorySubtract}"
                                   CommandParameter="{StaticResource Zero}"
                                   Content="&#xF758;" />
        <controls:CalculatorButton x:Name="MemButton"
                                   Grid.Column="4"
                                   Classes="symbol"
                                   AutomationProperties.AutomationId="memButton"
                                   AutomationProperties.Name="{utils:ResourceString Name='memButton.[using:Windows.UI.Xaml.Automation]AutomationProperties.Name'}"
                                   ButtonId="Memory"
                                   Content="&#xF756;" />
        <Button x:Name="MemoryButton"
                Grid.Column="6"
                MinWidth="15.5"
                MinHeight="8.402"
                FontFamily="{DynamicResource CalculatorFontFamily}"
                AutomationProperties.AutomationId="MemoryButton"
                AutomationProperties.Name="{utils:ResourceString Name='MemoryButton_Open'}"
                Click="ToggleMemoryFlyout"
                IsEnabled="{CompiledBinding !IsMemoryEmpty}"
                Content="&#xE61D;" />
      </Grid>

      <Grid x:Name="NumpadPanel"
            Grid.Row="5"
            Margin="3,0,3,3">
        <local:OperatorsPanel x:Name="OpsPanel"
                              IsBitFlipChecked="{CompiledBinding IsBitFlipChecked}" />
      </Grid>

      <Button x:Name="HistoryButton"
              Grid.Row="0"
              Margin="0,0,8,0"
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
              FontFamily="{DynamicResource CalculatorFontFamily}"
              FontSize="18"
              AutomationProperties.AutomationId="HistoryButton"
              AutomationProperties.Name="{utils:ResourceString Name='HistoryButton_Open'}"
              Click="ToggleHistoryFlyout"
              Content="&#xE81C;" />
    </Grid>

    <!-- The original docked History/Memory Pivot, with its copied template
         translated above and the original 560/1024/768x1366 state widths. -->
    <Border x:Name="DockPanel"
            Grid.Column="1"
            IsVisible="False"
            AutomationProperties.Name="{utils:ResourceString Name='DockPanel.[using:Windows.UI.Xaml.Automation]AutomationProperties.Name'}">
      <TabControl x:Name="DockTabs"
                  Theme="{StaticResource DockPivotStyle}"
                  Focusable="True"
                  SelectionChanged="OnDockSelectionChanged">
        <TabItem x:Name="HistoryTab"
                 Theme="{StaticResource DockPivotItemStyle}"
                 Header="{utils:ResourceString Name='HistoryLabel.Text'}"
                 AutomationProperties.AutomationId="HistoryLabel">
          <Border x:Name="DockHistoryHolder" Margin="0,10,0,0" />
        </TabItem>
        <TabItem x:Name="MemoryTab"
                 Theme="{StaticResource DockPivotItemStyle}"
                 Header="{utils:ResourceString Name='MemoryLabel.Text'}"
                 AutomationProperties.AutomationId="MemoryLabel">
          <Border x:Name="DockMemoryHolder" Margin="0,10,0,0" />
        </TabItem>
      </TabControl>
    </Border>

    <!-- WinUI Flyout Placement="Full" is an in-window light-dismiss layer.
         Avalonia's native Flyout is an anchored popup, so this is the direct
         translation of the original full placement and its reparenting
         holders. The History/Memory controls keep their original transparent
         top row and numpad-height opaque surface. -->
    <Grid x:Name="FullScreenFlyoutOverlay"
          Grid.Column="0"
          Panel.ZIndex="100"
          IsVisible="False">
      <Border Background="{DynamicResource SmokeFillColorDefaultBrush}"
              PointerPressed="OnFlyoutSmokePointerPressed" />
      <ContentControl x:Name="HistoryFlyoutHolder"
                      HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Stretch"
                      AutomationProperties.AutomationId="HistoryFlyout"
                      IsVisible="False" />
      <ContentControl x:Name="MemoryFlyoutHolder"
                      HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Stretch"
                      AutomationProperties.AutomationId="MemoryFlyout"
                      AutomationProperties.Name="{utils:ResourceString Name='MemoryFlyout.[using:Windows.UI.Xaml.Automation]AutomationProperties.Name'}"
                      IsVisible="False" />
    </Grid>

    <automation:NarratorNotifier x:Name="AnnouncementText"
                                  Announcement="{CompiledBinding Announcement}" />
  </Grid>
</UserControl>
