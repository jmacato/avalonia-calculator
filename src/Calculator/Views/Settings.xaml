<UserControl x:Class="CalculatorApp.Settings"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="using:CalculatorApp.ViewModel.Common.Automation"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             xmlns:utils="using:CalculatorApp.Utils"
             Loaded="OnLoaded">
  <Grid Background="{DynamicResource ApplicationPageBackgroundThemeBrush}"
        RowDefinitions="48,*">
    <Grid ColumnDefinitions="48,*">
      <Button x:Name="BackButton"
              Width="40" Height="40"
              Margin="4"
              Padding="0"
              FontFamily="{DynamicResource CalculatorFontFamily}"
              FontSize="20"
              AutomationProperties.AutomationId="SettingsBackButton"
              AutomationProperties.Name="{utils:ResourceString Name='TitleBarBackButton.[using:Windows.UI.Xaml.Automation]AutomationProperties.Name'}"
              Click="BackButton_Click"
              Content="&#xE72B;" />
      <TextBlock Grid.Column="1"
                 Margin="0,0,12,0"
                 VerticalAlignment="Center"
                 FontSize="20"
                 FontWeight="SemiBold"
                 Text="{utils:ResourceString Name=SettingsHeader.Text}" />
    </Grid>

    <ScrollViewer Grid.Row="1"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel MaxWidth="720"
                  Margin="24,8,24,24"
                  HorizontalAlignment="Left"
                  Spacing="6">
        <TextBlock Margin="0,6,0,4"
                   FontSize="15"
                   FontWeight="SemiBold"
                   Text="{utils:ResourceString Name=SettingsAppearance.Text}" />

        <fa:FASettingsExpander x:Name="AppThemeExpander"
                               Header="{utils:ResourceString Name=AppThemeExpander.Header}"
                               Description="{utils:ResourceString Name=AppThemeExpander.Description}"
                               IsExpanded="True">
          <fa:FASettingsExpanderItem>
            <StackPanel x:Name="ThemeRadioButtons" Spacing="6">
              <RadioButton x:Name="LightThemeRadioButton"
                           GroupName="AppTheme"
                           Tag="Light"
                           IsCheckedChanged="OnThemeSelectionChanged"
                           Content="{utils:ResourceString Name=LightThemeRadioButton.Content}" />
              <RadioButton x:Name="DarkThemeRadioButton"
                           GroupName="AppTheme"
                           Tag="Dark"
                           IsCheckedChanged="OnThemeSelectionChanged"
                           Content="{utils:ResourceString Name=DarkThemeRadioButton.Content}" />
              <RadioButton x:Name="SystemThemeRadioButton"
                           GroupName="AppTheme"
                           Tag="Default"
                           IsCheckedChanged="OnThemeSelectionChanged"
                           Content="{utils:ResourceString Name=SystemThemeRadioButton.Content}" />
            </StackPanel>
          </fa:FASettingsExpanderItem>
        </fa:FASettingsExpander>

        <fa:FASettingsExpander Header="Currency"
                               Description="Currency rate update behavior">
          <fa:FASettingsExpanderItem>
            <ToggleSwitch x:Name="AutomaticCurrencyRefreshToggle"
                          IsChecked="True"
                          Content="{utils:ResourceString Name=CurrencyAutomaticRefreshSetting}" />
          </fa:FASettingsExpanderItem>
        </fa:FASettingsExpander>

        <TextBlock Margin="0,24,0,4"
                   FontSize="15"
                   FontWeight="SemiBold"
                   Text="{utils:ResourceString Name=AboutGroupTitle.Text}" />

        <fa:FASettingsExpander x:Name="AboutExpander"
                               Header="Calculator"
                               Description="1.0.0 · jmacato · io.github.jmacato.calculator"
                               IsExpanded="True">
          <fa:FASettingsExpanderItem>
            <StackPanel Spacing="4">
              <Button Classes="settingsLink"
                      Tag="https://github.com/jmacato/Calc2"
                      Click="OpenLink_Click"
                      Content="{utils:ResourceString Name=AboutRepositoryLink}" />
              <Button Classes="settingsLink"
                      Tag="https://github.com/jmacato/Calc2/issues"
                      Click="OpenLink_Click"
                      Content="{utils:ResourceString Name=AboutIssuesLink}" />
              <Button Classes="settingsLink"
                      Tag="https://github.com/jmacato/Calc2/blob/main/LICENSE"
                      Click="OpenLink_Click"
                      Content="{utils:ResourceString Name=AboutLicenseLink}" />
            </StackPanel>
          </fa:FASettingsExpanderItem>
        </fa:FASettingsExpander>

        <fa:FASettingsExpander Header="{utils:ResourceString Name=AboutPrivacyHeading}">
          <fa:FASettingsExpanderItem>
            <TextBlock MaxWidth="620"
                       TextWrapping="Wrap"
                       Text="{utils:ResourceString Name=AboutPrivacyStatement}" />
          </fa:FASettingsExpanderItem>
        </fa:FASettingsExpander>

        <fa:FASettingsExpander Header="{utils:ResourceString Name=AboutAttributionsHeading}">
          <fa:FASettingsExpanderItem>
            <StackPanel MaxWidth="620" Spacing="7">
              <TextBlock TextWrapping="Wrap"
                         Text="{utils:ResourceString Name=AboutMicrosoftCredit}" />
              <TextBlock TextWrapping="Wrap"
                         Text="FluentAvalonia · MIT · a03fd9e02645c16ef0ebe7bb0266480eeb97871f" />
              <TextBlock TextWrapping="Wrap"
                         Text="Avalonia.Labs.Lottie · MIT · 7d86b80d576b9c0052fda104303c1ec1acb74f53" />
              <TextBlock TextWrapping="Wrap"
                         Text="Hind2 · b7d33b1be87b99512634725bf30d0dc59354bbd4" />
              <TextBlock TextWrapping="Wrap"
                         Text="Frankfurter v2 · Unicode CLDR 48.2" />
            </StackPanel>
          </fa:FASettingsExpanderItem>
        </fa:FASettingsExpander>
      </StackPanel>
    </ScrollViewer>

    <automation:NarratorNotifier x:Name="NarratorNotifier" />
  </Grid>
</UserControl>
