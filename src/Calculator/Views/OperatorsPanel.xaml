<UserControl x:Class="CalculatorApp.OperatorsPanel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:CalculatorApp"
             xmlns:model="using:CalculatorApp.ViewModel"
             x:DataType="model:StandardCalculatorViewModel"
             x:CompileBindings="True">
  <Grid>
    <local:CalculatorStandardOperators x:Name="StandardOperators"
                                       IsEnabled="{CompiledBinding IsStandard}"
                                       IsVisible="{CompiledBinding IsStandard}" />
    <!-- Avalonia has no x:Load equivalent. Keep lightweight hosts in the
         initial tree and construct each mode-specific panel on first use. -->
    <Grid x:Name="ScientificOperatorsHost"
          IsEnabled="{CompiledBinding IsScientific}"
          IsVisible="{CompiledBinding IsScientific}" />
    <Grid x:Name="BitFlipPanelHost"
          IsEnabled="{CompiledBinding IsBinaryBitFlippingEnabled}"
          IsVisible="{CompiledBinding IsBinaryBitFlippingEnabled}" />
    <Grid x:Name="ProgrammerRadixOperatorsHost"
          IsEnabled="{CompiledBinding IsProgrammer}"
          IsVisible="{CompiledBinding AreProgrammerRadixOperatorsVisible}" />
  </Grid>
</UserControl>
