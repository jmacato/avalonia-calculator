<UserControl x:Class="CalculatorApp.GraphingNumPad"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:CalculatorApp.Controls"
             xmlns:vm="using:CalculatorApp.ViewModel"
             x:DataType="vm:GraphingCalculatorViewModel"
             x:CompileBindings="True">
  <Grid RowDefinitions="*,*,*,*,*,*" ColumnDefinitions="*,*,*,*">
    <Button Command="{CompiledBinding AppendTokenCommand}" CommandParameter="sin(" Content="sin" />
    <Button Grid.Column="1" Command="{CompiledBinding AppendTokenCommand}" CommandParameter="cos(" Content="cos" />
    <Button Grid.Column="2" Command="{CompiledBinding AppendTokenCommand}" CommandParameter="tan(" Content="tan" />
    <Button Grid.Column="3" Command="{CompiledBinding AppendTokenCommand}" CommandParameter="^">
      <Button.Content>
        <TextBlock FontFamily="{DynamicResource CalculatorFontFamily}"
                   FontSize="20"
                   Text="&#xF7CA;" />
      </Button.Content>
    </Button>

    <Button Grid.Row="1" Command="{CompiledBinding AppendTokenCommand}" CommandParameter="(" Content="(" />
    <Button Grid.Row="1" Grid.Column="1" Command="{CompiledBinding AppendTokenCommand}" CommandParameter=")" Content=")" />
    <Button Grid.Row="1" Grid.Column="2" Command="{CompiledBinding ClearExpressionCommand}" Content="CE" />
    <Button Grid.Row="1"
            Grid.Column="3"
            FontFamily="{DynamicResource CalculatorFontFamily}"
            Command="{CompiledBinding BackspaceCommand}"
            Content="&#xE94F;" />

    <controls:CalculatorButton Grid.Row="2" ButtonId="Seven" Content="7" />
    <controls:CalculatorButton Grid.Row="2" Grid.Column="1" ButtonId="Eight" Content="8" />
    <controls:CalculatorButton Grid.Row="2" Grid.Column="2" ButtonId="Nine" Content="9" />
    <controls:CalculatorButton Grid.Row="2" Grid.Column="3" ButtonId="Divide" Content="÷" />
    <controls:CalculatorButton Grid.Row="3" ButtonId="Four" Content="4" />
    <controls:CalculatorButton Grid.Row="3" Grid.Column="1" ButtonId="Five" Content="5" />
    <controls:CalculatorButton Grid.Row="3" Grid.Column="2" ButtonId="Six" Content="6" />
    <controls:CalculatorButton Grid.Row="3" Grid.Column="3" ButtonId="Multiply" Content="×" />
    <controls:CalculatorButton Grid.Row="4" ButtonId="One" Content="1" />
    <controls:CalculatorButton Grid.Row="4" Grid.Column="1" ButtonId="Two" Content="2" />
    <controls:CalculatorButton Grid.Row="4" Grid.Column="2" ButtonId="Three" Content="3" />
    <controls:CalculatorButton Grid.Row="4" Grid.Column="3" ButtonId="Subtract" Content="−" />
    <Button Grid.Row="5" Command="{CompiledBinding AppendTokenCommand}" CommandParameter="x" Content="x" />
    <controls:CalculatorButton Grid.Row="5" Grid.Column="1" ButtonId="Zero" Content="0" />
    <controls:CalculatorButton Grid.Row="5" Grid.Column="2" ButtonId="Decimal" Content="." />
    <controls:CalculatorButton Grid.Row="5" Grid.Column="3" ButtonId="Add" Content="+" />
  </Grid>
</UserControl>
