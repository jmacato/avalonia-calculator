<UserControl x:Class="CalculatorApp.GraphingCalculator"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             xmlns:local="using:CalculatorApp"
             xmlns:utils="using:CalculatorApp.Utils"
             xmlns:vm="using:CalculatorApp.ViewModel"
             x:DataType="vm:GraphingCalculatorViewModel"
             x:CompileBindings="True"
             Loaded="OnLoaded"
             SizeChanged="OnSizeChanged">
  <UserControl.Styles>
    <!-- Avalonia translation of the original 64x30 GraphModeToggleSwitch. -->
    <Style Selector="ToggleButton.graphMode">
      <Setter Property="Width" Value="64" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid Width="64" Height="30">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}" />
            <Border x:Name="SwitchKnob"
                    Width="32"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                    CornerRadius="4" />
            <Grid x:Name="IconsPanelOff"
                  ColumnDefinitions="32,32">
              <TextBlock HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                         FontFamily="{DynamicResource CalculatorFontFamily}"
                         FontSize="14"
                         Text="&#xF770;" />
              <Grid Grid.Column="1">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           FontFamily="{DynamicResource CalculatorFontFamily}"
                           FontSize="12"
                           Text="&#xF893;" />
                <TextBlock Margin="0,8,7,0"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           FontSize="10"
                           Text="x" />
              </Grid>
            </Grid>
            <Grid x:Name="IconsPanelOn"
                  Opacity="0"
                  ColumnDefinitions="32,32">
              <TextBlock HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                         FontFamily="{DynamicResource CalculatorFontFamily}"
                         FontSize="14"
                         Text="&#xF770;" />
              <Grid Grid.Column="1">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                           FontFamily="{DynamicResource CalculatorFontFamily}"
                           FontSize="12"
                           Text="&#xF893;" />
                <TextBlock Margin="0,8,7,0"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                           FontSize="10"
                           Text="x" />
              </Grid>
            </Grid>
          </Grid>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ToggleButton.graphMode:checked /template/ Border#SwitchKnob">
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="ToggleButton.graphMode:checked /template/ Grid#IconsPanelOff">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="ToggleButton.graphMode:checked /template/ Grid#IconsPanelOn">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </UserControl.Styles>

  <!-- Original GraphingCalculator root: 2*:1*, equation pane constrained to
       300..420, and a single-panel overlay below 800 pixels. -->
  <Grid x:Name="GraphingRoot">
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="2*" />
      <ColumnDefinition Width="1*" MinWidth="300" MaxWidth="420" />
    </Grid.ColumnDefinitions>

    <Grid Grid.ColumnSpan="2">
      <ToggleButton x:Name="SwitchModeToggleButton"
                    Classes="graphMode"
                    Margin="0,0,12,2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="SwitchModeToggleButton"
                    AutomationProperties.Name="{utils:ResourceString Name='SwitchModeToggleButton.[using:Windows.UI.Xaml.Automation]AutomationProperties.Name'}"
                    IsCheckedChanged="OnSwitchModeChanged" />
    </Grid>

    <fa:FAInfoBar x:Name="LimitationInfoBar"
                  Grid.Row="1"
                  Grid.ColumnSpan="2"
                  Margin="4,0"
                  IsOpen="True"
                  IsClosable="False"
                  Severity="Warning"
                  Message="{CompiledBinding LimitationNotice}" />

    <!-- LeftGrid is the graph panel in the original source. -->
    <Border x:Name="LeftGrid"
            Grid.Row="2"
            Grid.Column="0"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            ClipToBounds="True"
            AutomationProperties.AutomationId="GraphingPlotArea"
            AutomationProperties.Name="{utils:ResourceString Name='GraphingPlotUnavailableLabel'}">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Margin="8"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="4">
          <Button IsEnabled="{CompiledBinding EngineActionsEnabled}"
                  AutomationProperties.Name="{utils:ResourceString Name='zoomOutButton.[using:Windows.UI.Xaml.Automation]AutomationProperties.Name'}"
                  Content="−" />
          <Button IsEnabled="{CompiledBinding EngineActionsEnabled}"
                  AutomationProperties.Name="{utils:ResourceString Name='zoomInButton.[using:Windows.UI.Xaml.Automation]AutomationProperties.Name'}"
                  Content="+" />
          <Button IsEnabled="{CompiledBinding EngineActionsEnabled}"
                  AutomationProperties.Name="{utils:ResourceString Name='GraphOptionsHeading.Text'}"
                  Content="⋯" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="12">
          <Border Height="1" Background="{DynamicResource TextFillColorDisabledBrush}" />
          <Border Width="1" Background="{DynamicResource TextFillColorDisabledBrush}" />
          <TextBlock Margin="24"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     FontSize="18"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                     Text="{utils:ResourceString Name='GraphingPlotUnavailableLabel'}"
                     TextAlignment="Center"
                     TextWrapping="Wrap" />
        </Grid>
        <StackPanel Grid.Row="2"
                    Margin="10"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="6">
          <Button IsEnabled="{CompiledBinding EngineActionsEnabled}" Content="Plot" />
          <Button IsEnabled="{CompiledBinding EngineActionsEnabled}" Content="Trace" />
          <Button IsEnabled="{CompiledBinding EngineActionsEnabled}" Content="Function analysis" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- RightGrid is the equation editor/keypad pane in the original source. -->
    <Grid x:Name="RightGrid"
          Grid.Row="2"
          Grid.Column="1"
          RowDefinitions="*,2.2*">
      <local:EquationInputArea x:Name="EquationInputAreaControl"
                               Margin="0,4,0,0" />
      <local:GraphingNumPad x:Name="GraphingNumPad"
                            Grid.Row="1"
                            MaxHeight="400"
                            Margin="2,0,2,2" />
    </Grid>
  </Grid>
</UserControl>
