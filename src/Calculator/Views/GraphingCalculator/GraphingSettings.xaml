<UserControl x:Class="CalculatorApp.GraphingSettings"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:utils="using:CalculatorApp.Utils">
  <StackPanel Spacing="10" IsEnabled="False">
    <TextBlock FontSize="18" FontWeight="SemiBold"
               Text="{utils:ResourceString Name=GraphOptionsHeading.Text}" />
    <TextBlock FontWeight="SemiBold" Text="{utils:ResourceString Name=GridHeading.Text}" />
    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
      <TextBox PlaceholderText="{utils:ResourceString Name=GraphSettingsXMin.Header}" />
      <TextBox Grid.Column="1" PlaceholderText="{utils:ResourceString Name=GraphSettingsXMax.Header}" />
      <TextBox Grid.Row="1" PlaceholderText="{utils:ResourceString Name=GraphSettingsYMin.Header}" />
      <TextBox Grid.Row="1" Grid.Column="1" PlaceholderText="{utils:ResourceString Name=GraphSettingsYMax.Header}" />
    </Grid>
    <TextBlock FontWeight="SemiBold" Text="{utils:ResourceString Name=UnitsHeading.Text}" />
    <RadioButton Content="{utils:ResourceString Name=TrigModeRadians.Content}" />
    <RadioButton Content="{utils:ResourceString Name=TrigModeDegrees.Content}" />
    <RadioButton Content="{utils:ResourceString Name=TrigModeGradians.Content}" />
  </StackPanel>
</UserControl>
