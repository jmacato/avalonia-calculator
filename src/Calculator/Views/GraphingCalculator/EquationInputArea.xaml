<UserControl x:Class="CalculatorApp.EquationInputArea"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:utils="using:CalculatorApp.Utils"
             xmlns:vm="using:CalculatorApp.ViewModel"
             x:DataType="vm:GraphingCalculatorViewModel"
             x:CompileBindings="True">
  <Grid RowDefinitions="Auto,8,*">
    <TextBlock FontSize="15"
               FontWeight="SemiBold"
               Text="{utils:ResourceString Name=GraphingExpressionEditorLabel}" />
    <TextBox x:Name="ExpressionEditor"
             Grid.Row="2"
             MinHeight="120"
             Padding="12"
             AcceptsReturn="True"
             TextWrapping="Wrap"
             PlaceholderText="f(x) ="
             Text="{CompiledBinding ExpressionText, Mode=TwoWay}"
             AutomationProperties.AutomationId="GraphingExpressionEditor"
             AutomationProperties.Name="{utils:ResourceString Name=GraphingExpressionEditorLabel}" />
  </Grid>
</UserControl>
