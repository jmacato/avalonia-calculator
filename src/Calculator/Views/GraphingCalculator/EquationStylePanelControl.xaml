<UserControl x:Class="CalculatorApp.EquationStylePanelControl"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:utils="using:CalculatorApp.Utils">
  <StackPanel Spacing="10" IsEnabled="False">
    <TextBlock FontSize="18" FontWeight="SemiBold"
               Text="{utils:ResourceString Name=LineOptionsHeading.Text}" />
    <TextBlock Text="{utils:ResourceString Name=LineColorText.Text}" />
    <ComboBox SelectedIndex="0">
      <ComboBoxItem Content="Blue" />
      <ComboBoxItem Content="Red" />
      <ComboBoxItem Content="Green" />
    </ComboBox>
    <TextBlock Text="{utils:ResourceString Name=StyleChooserBoxHeading.Text}" />
    <ComboBox SelectedIndex="0">
      <ComboBoxItem Content="Solid" />
      <ComboBoxItem Content="Dashed" />
    </ComboBox>
  </StackPanel>
</UserControl>
