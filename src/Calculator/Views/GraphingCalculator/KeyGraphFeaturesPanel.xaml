<UserControl x:Class="CalculatorApp.KeyGraphFeaturesPanel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:CalculatorApp.Controls"
             xmlns:math="using:MathComposer.Avalonia.Controls"
             xmlns:mathCore="using:MathComposer.Core"
             xmlns:ts="using:CalculatorApp.TemplateSelectors"
             xmlns:utils="using:CalculatorApp.Utils"
             xmlns:vm="using:CalculatorApp.ViewModel"
             x:DataType="vm:KeyGraphFeaturesViewModel"
             x:CompileBindings="True"
             Background="{DynamicResource ApplicationPageBackgroundThemeBrush}">
  <UserControl.Styles>
    <Style Selector="Button.kgfBackButton">
      <Setter Property="MinWidth" Value="44" />
      <Setter Property="Padding" Value="5,0" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid Background="{TemplateBinding Background}">
            <Border x:Name="BackButtonOverlay"
                    Background="{DynamicResource TextFillColorPrimaryBrush}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Opacity="0" />
            <ContentPresenter Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}" />
          </Grid>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.kgfBackButton:pointerover /template/ Border#BackButtonOverlay">
      <Setter Property="Opacity" Value="0.2" />
    </Style>
    <Style Selector="Button.kgfBackButton:pressed /template/ Border#BackButtonOverlay">
      <Setter Property="Opacity" Value="0.4" />
    </Style>

    <Style Selector="TextBlock.kgfTitle">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="SelectableTextBlock.kgfText">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="math|MathDisplay.kgfMath">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="MathFontSize" Value="14" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <!-- WinUI fully hides an auto-hidden scrollbar. Avalonia's Fluent theme
         leaves its narrow panning thumb visible until the bar expands. -->
    <Style Selector="ScrollViewer.kgfScroller /template/ ScrollBar /template/ Thumb">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ScrollViewer.kgfScroller /template/ ScrollBar[IsExpanded=true] /template/ Thumb">
      <Setter Property="Background" Value="{DynamicResource ScrollBarThumbBackgroundColor}" />
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>
    <DataTemplate x:Key="KGFRichEditDataTemplate" x:DataType="vm:KeyGraphFeaturesItem">
      <StackPanel Margin="0,10">
        <TextBlock Classes="kgfTitle" Text="{CompiledBinding Title}" />
        <ItemsControl ItemsSource="{CompiledBinding DisplayMathDocuments}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="mathCore:MathDocument">
              <math:MathDisplay Margin="1,2,0,0"
                                Classes="kgfMath"
                                Document="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="KGFGridDataTemplate" x:DataType="vm:KeyGraphFeaturesItem">
      <StackPanel Margin="0,10">
        <TextBlock Classes="kgfTitle" Text="{CompiledBinding Title}" />
        <ItemsControl ItemsSource="{CompiledBinding GridItems}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:GridDisplayItems">
              <Grid ColumnDefinitions="Auto,Auto" VerticalAlignment="Center">
                <math:MathDisplay MinWidth="64"
                                  Margin="1,2,0,0"
                                  Classes="kgfMath"
                                  Document="{CompiledBinding Document}" />
                <TextBlock Grid.Column="1"
                           Margin="0,-2,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           FontSize="14"
                           Text="{CompiledBinding Direction}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="KGFTextBlockDataTemplate" x:DataType="vm:KeyGraphFeaturesItem">
      <StackPanel Margin="0,10">
        <TextBlock Classes="kgfTitle" Text="{CompiledBinding Title}" />
        <ItemsControl ItemsSource="{CompiledBinding DisplayItems}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <SelectableTextBlock Classes="kgfText" Text="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>

    <ts:KeyGraphFeaturesTemplateSelector x:Key="KGFTemplateSelector"
                                         GridTemplate="{StaticResource KGFGridDataTemplate}"
                                         RichEditTemplate="{StaticResource KGFRichEditDataTemplate}"
                                         TextBlockTemplate="{StaticResource KGFTextBlockDataTemplate}" />
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,Auto,*"
        AutomationProperties.Name="Function analysis">
    <Border MinHeight="48"
            Margin="5,0,4,0"
            Background="{DynamicResource TextControlBackground}"
            CornerRadius="{DynamicResource ControlCornerRadius}">
      <Grid ColumnDefinitions="Auto,*">
        <Button x:Name="BackButton"
                Classes="kgfBackButton"
                MinWidth="76"
                VerticalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                AutomationProperties.Name="Back"
                Background="{CompiledBinding LineBrush}"
                Click="OnCloseClicked">
          <StackPanel HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Orientation="Horizontal">
            <TextBlock Margin="0,0,6,0"
                       VerticalAlignment="Center"
                       FontFamily="{DynamicResource CalculatorFontFamily}"
                       FontSize="16"
                       Text="&#xE72B;" />
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="{DynamicResource CalculatorFontFamily}"
                         FontSize="18"
                         Text="&#xF893;" />
              <TextBlock Margin="-5,15,0,0"
                         FontSize="11"
                         Text="{CompiledBinding FunctionLabelText}" />
            </StackPanel>
          </StackPanel>
        </Button>
        <math:MathDisplay Grid.Column="1"
                          Margin="10,0,6,0"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Classes="kgfMath"
                          MathFontSize="18"
                          Document="{CompiledBinding ExpressionDocument}" />
      </Grid>
    </Border>

    <TextBlock Grid.Row="1"
               Margin="13,12,10,0"
               FontSize="20"
               FontWeight="Medium"
               Text="{utils:ResourceString Name=KeyGraphFeaturesLabel.Text}" />

    <ScrollViewer Grid.Row="2"
                  Classes="kgfScroller"
                  Padding="13,9,10,12"
                  IsVisible="{CompiledBinding AnalysisItemsVisible}"
                  VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemTemplate="{StaticResource KGFTemplateSelector}"
                    ItemsSource="{CompiledBinding KeyGraphFeaturesItems}" />
    </ScrollViewer>

    <TextBlock Grid.Row="2"
               Margin="13,10,10,0"
               IsVisible="{CompiledBinding AnalysisErrorVisible}"
               FontSize="14"
               Text="{CompiledBinding AnalysisErrorString}"
               TextWrapping="Wrap" />
  </Grid>
</UserControl>
