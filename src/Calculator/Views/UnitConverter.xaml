<UserControl x:Class="CalculatorApp.UnitConverter"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="using:CalculatorApp.ViewModel.Common.Automation"
             xmlns:controls="using:CalculatorApp.Controls"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             xmlns:local="using:CalculatorApp"
             xmlns:utils="using:CalculatorApp.Utils"
             xmlns:vm="using:CalculatorApp.ViewModel"
             xmlns:ucm="using:UnitConversionManager"
             x:DataType="vm:UnitConverterViewModel"
             x:CompileBindings="True"
             FlowDirection="LeftToRight"
             Focusable="True"
             KeyDown="OnKeyDown"
             Loaded="OnLoaded"
             SizeChanged="OnSizeChanged">
  <UserControl.Resources>
    <!-- Avalonia has no equivalent of WinUI's TextLineBounds="Full". The
         23-DIP line box at 14 DIPs preserves the native 37-DIP item pitch. -->
    <DataTemplate x:Key="UnitTemplate" x:DataType="ucm:Unit">
      <TextBlock Theme="{StaticResource BodyTextBlockStyle}"
                 LineHeight="23"
                 AutomationProperties.Name="{CompiledBinding AccessibleName}"
                 Text="{CompiledBinding Name}"
                 TextWrapping="NoWrap" />
    </DataTemplate>

    <!-- The original keeps a distinct selected-item template because the
         popup item template cannot safely be reused when SelectedItem is null. -->
    <DataTemplate x:Key="SelectedUnitTemplate" x:DataType="ucm:Unit">
      <TextBlock Theme="{StaticResource BodyTextBlockStyle}"
                 LineHeight="23"
                 FontWeight="Normal"
                 AutomationProperties.Name="{CompiledBinding AccessibleName}"
                 Text="{CompiledBinding Name}"
                 TextWrapping="NoWrap" />
    </DataTemplate>

    <!-- Unit-converter sizing/colors on the stock Avalonia ComboBox theme. -->
    <ControlTheme x:Key="ConverterComboBoxTheme"
                  TargetType="ComboBox"
                  BasedOn="{StaticResource {x:Type ComboBox}}">
      <Setter Property="Margin" Value="12,0,0,0" />
      <Setter Property="Padding" Value="4,0,0,0" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource ConverterComboBoxBorderBrush}" />
      <Setter Property="BorderThickness" Value="{DynamicResource ConverterComboBoxBorderThemeThickness}" />
      <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="False" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </ControlTheme>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="ComboBoxItem.touchInput">
      <Setter Property="Padding" Value="{DynamicResource ComboBoxItemThemeTouchPadding}" />
    </Style>
    <Style Selector="controls|CalculationResult.converterValue">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Bottom" />
      <Setter Property="Margin" Value="4,0,0,0" />
      <Setter Property="MinFontSize" Value="14" />
      <Setter Property="MaxFontSize" Value="40" />
      <Setter Property="FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}" />
      <Setter Property="DisplayMargin" Value="0,0,0,4" />
      <Setter Property="AdornmentSpacing" Value="1" />
      <Setter Property="AdornmentFontFamily" Value="{DynamicResource CurrencySymbolFontFamily}" />
      <Setter Property="AdornmentFontSize" Value="20" />
      <Setter Property="AdornmentFontWeight" Value="Light" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.currencyTimestamp.fresh">
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="TextBlock.currencyTimestamp.stale">
      <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.currencySecondaryStatus.failed">
      <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
    </Style>
    <Style Selector="ComboBox.unitPicker">
      <Setter Property="Theme" Value="{StaticResource ConverterComboBoxTheme}" />
    </Style>
  </UserControl.Styles>

  <!-- Direct translation of the original UnitConverterRootGrid. Avalonia does
       not have AspectRatioTrigger, so its exact state setters live in the
       code-behind. -->
  <Grid x:Name="UnitConverterRootGrid"
        AutomationProperties.LandmarkType="Main">
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="56*" MinHeight="56" />
      <RowDefinition Height="32*" MinHeight="32" />
      <RowDefinition Height="56*" MinHeight="56" />
      <RowDefinition Height="32*" MinHeight="32" />
      <RowDefinition Height="Auto" MinHeight="48" />
      <RowDefinition Height="272*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="0" />
      <ColumnDefinition Width="1*" />
      <ColumnDefinition Width="0" />
      <ColumnDefinition Width="0" />
    </Grid.ColumnDefinitions>

    <!-- Direct port of CurrencyLoadingGrid and its ProgressRing. The loaded
         converter remains laid out underneath so the responsive rows do not
         jump while a refresh is in flight. -->
    <Grid x:Name="CurrencyLoadingGrid"
          Grid.Row="1"
          Grid.RowSpan="5"
          Grid.ColumnSpan="4"
          ZIndex="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="10*" />
        <RowDefinition Height="7*" />
        <RowDefinition Height="10*" />
      </Grid.RowDefinitions>
      <Viewbox Grid.Row="1"
               MaxWidth="140"
               MaxHeight="140"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"
               Stretch="Uniform">
        <fa:FAProgressRing x:Name="CurrencyLoadingProgressRing"
                           Width="80"
                           Height="80"
                           IsActive="False" />
      </Viewbox>
    </Grid>

    <Grid x:Name="Value1Container"
          Grid.Row="1"
          Grid.Column="1"
          HorizontalAlignment="Left"
          controls:CompositionMotionBehavior.Profile="{StaticResource CurrencyLoadedAnimation}"
          AutomationProperties.AccessibilityView="Raw">
      <controls:CalculationResult x:Name="Value1"
                                  Classes="converterValue"
                                  AdornmentText="{CompiledBinding DisplayUnit1}"
                                  IsAdornmentOnRight="{CompiledBinding DisplayUnit1OnRight}"
                                  AutomationProperties.AutomationId="Value1"
                                  AutomationProperties.Name="{CompiledBinding Value1AutomationName}"
                                  ContextRequested="OnResultContextRequested"
                                  DisplayValue="{CompiledBinding Value1}"
                                  IsActive="{CompiledBinding Value1Active, Mode=TwoWay}"
                                  Selected="OnValueSelected"
                                  TabIndex="1">
        <controls:CalculationResult.ContextMenu>
          <ContextMenu Closed="OnResultContextMenuClosed">
            <MenuItem Header="{utils:ResourceString Name='copyMenuItem'}"
                      AutomationProperties.AutomationId="Value1CopyMenuItem"
                      Click="OnCopyMenuItemClicked" />
            <MenuItem Header="{utils:ResourceString Name='pasteMenuItem'}"
                      AutomationProperties.AutomationId="Value1PasteMenuItem"
                      Classes="paste"
                      Click="OnPasteMenuItemClicked" />
          </ContextMenu>
        </controls:CalculationResult.ContextMenu>
      </controls:CalculationResult>
    </Grid>

    <ComboBox x:Name="Units1"
                                Grid.Row="2"
                                Grid.Column="1"
                                controls:CompositionMotionBehavior.Profile="{StaticResource CurrencyLoadedAnimation}"
                                Classes="unitPicker"
                                ItemsSource="{CompiledBinding Units}"
                                ItemTemplate="{StaticResource UnitTemplate}"
                                IsEnabled="{CompiledBinding IsDropDownEnabled}"
                                SelectedItem="{CompiledBinding Unit1, Mode=TwoWay}"
                                DropDownOpened="UpdateDropDownState"
                                DropDownClosed="UpdateDropDownState"
                                AutomationProperties.AutomationId="Units1"
                                AutomationProperties.Name="{CompiledBinding Unit1AutomationName}"
                                TabIndex="2" />

    <Grid x:Name="Value2Container"
          Grid.Row="3"
          Grid.Column="1"
          HorizontalAlignment="Left"
          controls:CompositionMotionBehavior.Profile="{StaticResource CurrencyLoadedAnimation}"
          AutomationProperties.AccessibilityView="Raw">
      <controls:CalculationResult x:Name="Value2"
                                  Classes="converterValue"
                                  AdornmentText="{CompiledBinding DisplayUnit2}"
                                  IsAdornmentOnRight="{CompiledBinding DisplayUnit2OnRight}"
                                  AutomationProperties.AutomationId="Value2"
                                  AutomationProperties.LiveSetting="Polite"
                                  AutomationProperties.Name="{CompiledBinding Value2AutomationName}"
                                  ContextRequested="OnResultContextRequested"
                                  DisplayValue="{CompiledBinding Value2}"
                                  IsActive="{CompiledBinding Value2Active, Mode=TwoWay}"
                                  Selected="OnValueSelected"
                                  TabIndex="3">
        <controls:CalculationResult.ContextMenu>
          <ContextMenu Closed="OnResultContextMenuClosed">
            <MenuItem Header="{utils:ResourceString Name='copyMenuItem'}"
                      AutomationProperties.AutomationId="Value2CopyMenuItem"
                      Click="OnCopyMenuItemClicked" />
            <MenuItem Header="{utils:ResourceString Name='pasteMenuItem'}"
                      AutomationProperties.AutomationId="Value2PasteMenuItem"
                      Classes="paste"
                      Click="OnPasteMenuItemClicked" />
          </ContextMenu>
        </controls:CalculationResult.ContextMenu>
      </controls:CalculationResult>
    </Grid>

    <ComboBox x:Name="Units2"
                                Grid.Row="4"
                                Grid.Column="1"
                                controls:CompositionMotionBehavior.Profile="{StaticResource CurrencyLoadedAnimation}"
                                Classes="unitPicker"
                                ItemsSource="{CompiledBinding Units}"
                                ItemTemplate="{StaticResource UnitTemplate}"
                                IsEnabled="{CompiledBinding IsDropDownEnabled}"
                                SelectedItem="{CompiledBinding Unit2, Mode=TwoWay}"
                                DropDownOpened="UpdateDropDownState"
                                DropDownClosed="UpdateDropDownState"
                                AutomationProperties.AutomationId="Units2"
                                AutomationProperties.Name="{CompiledBinding Unit2AutomationName}"
                                TabIndex="4" />

    <StackPanel x:Name="SupplementaryResultsPanelInGrid"
                Grid.Row="5"
                Grid.Column="1"
                MinHeight="48"
                Margin="0,0,6,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                SizeChanged="OnSupplementaryResultsPanelSizeChanged">
      <local:SupplementaryResults x:Name="SupplementaryResults"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Results="{CompiledBinding SupplementaryResults}"
                                  IsVisible="{CompiledBinding HasSupplementaryResults}" />
      <StackPanel IsVisible="{CompiledBinding IsCurrencyCurrentCategory}">
          <TextBlock x:Name="CurrencyRatioEqualityBlock"
                     Margin="16,0,0,0"
                     Classes="caption"
                     controls:CompositionMotionBehavior.Profile="{StaticResource CurrencyLoadedAnimation}"
                     AutomationProperties.Name="{CompiledBinding CurrencyRatioEqualityAutomationName}"
                     Text="{CompiledBinding CurrencyRatioEquality}" />
          <TextBlock x:Name="CurrencyTimestampTextBlock"
                     Margin="16,0,0,0"
                     Classes="caption currencyTimestamp"
                     Classes.stale="{CompiledBinding CurrencyDataIsWeekOld}"
                     controls:CompositionMotionBehavior.Profile="{StaticResource CurrencyLoadedAnimation}"
                     Text="{CompiledBinding CurrencyTimestamp}" />
          <StackPanel x:Name="CurrencyRefreshBlockControl"
                      Orientation="Horizontal">
            <HyperlinkButton x:Name="CurrencyRefreshBlock"
                             Margin="16,4,0,0"
                             Padding="0"
                             Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                             Background="Transparent"
                             BorderThickness="0"
                             Click="CurrencyRefreshButton_Click"
                             AutomationProperties.AutomationId="CurrencyRefreshBlock"
                             TabIndex="5"
                             Content="{utils:ResourceString Name='RefreshButtonText.Content'}">
              <HyperlinkButton.Resources>
                <SolidColorBrush x:Key="HyperlinkButtonBackgroundPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="HyperlinkButtonBackgroundPressed" Color="Transparent" />
              </HyperlinkButton.Resources>
            </HyperlinkButton>
            <TextBlock x:Name="CurrencySecondaryStatus"
                       Margin="3,6,0,0"
                       Classes="caption currencySecondaryStatus"
                       Classes.failed="{CompiledBinding CurrencyDataLoadFailed}" />
          </StackPanel>
          <WrapPanel x:Name="OfflineBlock"
                     Margin="16,4,0,0"
                     IsVisible="False"
                     Orientation="Horizontal">
            <TextBlock x:Name="OfflineRunBeforeLink"
                       Classes="caption"
                       AutomationProperties.AccessibilityView="Raw"
                       VerticalAlignment="Center" />
            <HyperlinkButton x:Name="OfflineNetworkSettingsButton"
                             Margin="3,0,0,0"
                             Padding="0"
                             Background="Transparent"
                             BorderThickness="0"
                             TabIndex="5">
              <TextBlock x:Name="OfflineRunLink"
                         Classes="caption"
                         AutomationProperties.AccessibilityView="Raw"
                         Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
              <HyperlinkButton.Resources>
                <SolidColorBrush x:Key="HyperlinkButtonBackgroundPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="HyperlinkButtonBackgroundPressed" Color="Transparent" />
              </HyperlinkButton.Resources>
            </HyperlinkButton>
            <TextBlock x:Name="OfflineRunAfterLink"
                       Margin="3,0,0,0"
                       Classes="caption"
                       AutomationProperties.AccessibilityView="Raw"
                       VerticalAlignment="Center" />
          </WrapPanel>
      </StackPanel>
    </StackPanel>

    <Grid x:Name="ConverterNumPad"
          controls:CompositionMotionBehavior.Profile="{StaticResource KeypadEntranceAnimation}"
          Grid.Row="6"
          Grid.Column="1"
          Margin="3,0,3,3"
          RenderTransformOrigin="50%,50%"
          XYFocus.NavigationModes="Enabled"
          RowDefinitions="*,*,*,*,*"
          ColumnDefinitions="*,*,*">
      <Grid.RenderTransform>
        <ScaleTransform />
      </Grid.RenderTransform>
      <Grid Grid.Column="1"
            Grid.ColumnSpan="2"
            AutomationProperties.HeadingLevel="1"
            AutomationProperties.Name="{utils:ResourceString Name='DisplayControls.[using:Windows.UI.Xaml.Automation]AutomationProperties.Name'}"
            ColumnDefinitions="*,*">
        <controls:CalculatorButton x:Name="ClearEntryButtonPos0"
                                   Classes="operator"
                                   AutomationProperties.AutomationId="ClearEntryButtonPos0"
                                   AutomationProperties.Name="{utils:ResourceString Name='clearEntryButton.[using:Windows.UI.Xaml.Automation]AutomationProperties.Name'}"
                                   ButtonId="Clear"
                                   Content="CE"
                                   TabIndex="7" />
        <controls:CalculatorButton x:Name="BackSpaceButtonSmall"
                                   Grid.Column="1"
                                   Classes="operator symbol"
                                   FontFamily="{DynamicResource CalculatorFontFamily}"
                                   AutomationProperties.AutomationId="BackSpaceButtonSmall"
                                   AutomationProperties.Name="{utils:ResourceString Name='backSpaceButton.[using:Windows.UI.Xaml.Automation]AutomationProperties.Name'}"
                                   ButtonId="Backspace"
                                   Content="&#xE94F;"
                                   TabIndex="8" />
      </Grid>

      <local:NumberPad x:Name="NumberPad"
                       Grid.Row="1"
                       Grid.RowSpan="4"
                       Grid.ColumnSpan="3"
                       IsDecimalEnabled="{CompiledBinding IsDecimalEnabled}"
                       AutomationProperties.AutomationId="NumberPad"
                       AutomationProperties.HeadingLevel="1"
                       AutomationProperties.Name="{utils:ResourceString Name='NumberPad.[using:Windows.UI.Xaml.Automation]AutomationProperties.Name'}"
                       KeyboardNavigation.TabNavigation="Local"
                       TabIndex="10" />
      <controls:CalculatorButton x:Name="ConverterNegateButton"
                                 Grid.Row="4"
                                 Classes="operator symbol"
                                 FontFamily="{DynamicResource CalculatorFontFamily}"
                                 IsVisible="{CompiledBinding CanNegate}"
                                 AutomationProperties.AutomationId="ConverterNegateButton"
                                 AutomationProperties.Name="{utils:ResourceString Name='converterNegateButton.[using:Windows.UI.Xaml.Automation]AutomationProperties.Name'}"
                                 ButtonId="Negate"
                                 Content="&#xF898;"
                                 TabIndex="6"
                                 ZIndex="2" />
    </Grid>

    <automation:NarratorNotifier Announcement="{CompiledBinding Announcement}" />
  </Grid>
</UserControl>
