      <!-- Original Calculator sizing resources, translated from the WinUI dictionary. -->
      <x:Double x:Key="AppMinWindowWidth">320</x:Double>
      <x:Double x:Key="AppMinWindowHeight">500</x:Double>
      <x:Double x:Key="HamburgerHeight">48</x:Double>
      <GridLength x:Key="HamburgerHeightGridLength">48</GridLength>
      <!-- Calculator's original App.xaml overrides the WinUI Pivot defaults. -->
      <Thickness x:Key="PivotPortraitThemePadding">0,1,0,0</Thickness>
      <x:Double x:Key="PivotHeaderItemFontSize">14</x:Double>
      <FontWeight x:Key="PivotHeaderItemThemeFontWeight">Normal</FontWeight>
      <x:Double x:Key="CalcButtonCaptionSize">34</x:Double>
      <x:Double x:Key="CalcOperatorCaptionSize">20</x:Double>
      <x:Int32 x:Key="Zero">0</x:Int32>
      <!-- UnitConverter.xaml's original ControlBorderThemeThickness is zero
           in light/dark themes and one device-independent pixel in high contrast. -->
      <Thickness x:Key="ConverterComboBoxBorderThemeThickness">0</Thickness>
      <SolidColorBrush x:Key="ConverterComboBoxBorderBrush" Color="Transparent" />

      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <StaticResource x:Key="NavigationViewDefaultPaneBackground"
                          ResourceKey="AcrylicInAppFillColorDefaultBrush" />
          <Color x:Key="CalcButtonBaseFillColor">#FFFFFF</Color>
          <StaticResource x:Key="CalcButtonTextFillColorDefaultBrush"
                          ResourceKey="TextFillColorPrimaryBrush" />
          <StaticResource x:Key="CalcButtonTextFillColorHoverBrush"
                          ResourceKey="TextFillColorPrimaryBrush" />
          <StaticResource x:Key="CalcButtonTextFillColorPressedBrush"
                          ResourceKey="TextFillColorSecondaryBrush" />
          <StaticResource x:Key="CalcButtonTextFillColorDisabledBrush"
                          ResourceKey="TextFillColorDisabledBrush" />
          <SolidColorBrush x:Key="CalcButtonFillColorDefaultBrush" Color="#FFFFFF" Opacity="0.125" />
          <SolidColorBrush x:Key="CalcButtonFillColorHoverBrush" Color="#FFFFFF" Opacity="0.0852" />
          <SolidColorBrush x:Key="CalcButtonFillColorPressedBrush" Color="#FFFFFF" Opacity="0.0359" />
          <SolidColorBrush x:Key="CalcButtonFillColorDisabledBrush" Color="#FFFFFF" Opacity="0.0359" />
          <SolidColorBrush x:Key="CalcButtonAltFillColorDefaultBrush" Color="#FFFFFF" Opacity="0.0852" />
          <SolidColorBrush x:Key="CalcButtonAltFillColorHoverBrush" Color="#FFFFFF" Opacity="0.1256" />
          <SolidColorBrush x:Key="CalcButtonAltFillColorPressedBrush" Color="#FFFFFF" Opacity="0.0852" />
          <SolidColorBrush x:Key="CalcButtonAltFillColorDisabledBrush" Color="#FFFFFF" Opacity="0.0359" />
          <SolidColorBrush x:Key="AppControlHighlightCalcButtonHoverBrush"
                           Color="{DynamicResource SystemAccentColor}"
                           Opacity="0.9" />
          <SolidColorBrush x:Key="AppControlTransparentButtonBackgroundBrush" Color="Transparent" />
          <StaticResource x:Key="AppControlBackgroundTertiaryBrush"
                          ResourceKey="SubtleFillColorTertiaryBrush" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <StaticResource x:Key="NavigationViewDefaultPaneBackground"
                          ResourceKey="AcrylicInAppFillColorDefaultBrush" />
          <Color x:Key="CalcButtonBaseFillColor">#FFFFFF</Color>
          <StaticResource x:Key="CalcButtonTextFillColorDefaultBrush"
                          ResourceKey="TextFillColorPrimaryBrush" />
          <StaticResource x:Key="CalcButtonTextFillColorHoverBrush"
                          ResourceKey="TextFillColorPrimaryBrush" />
          <StaticResource x:Key="CalcButtonTextFillColorPressedBrush"
                          ResourceKey="TextFillColorSecondaryBrush" />
          <StaticResource x:Key="CalcButtonTextFillColorDisabledBrush"
                          ResourceKey="TextFillColorDisabledBrush" />
          <SolidColorBrush x:Key="CalcButtonFillColorDefaultBrush" Color="#FFFFFF" Opacity="1" />
          <SolidColorBrush x:Key="CalcButtonFillColorHoverBrush" Color="#FFFFFF" Opacity="0.75" />
          <SolidColorBrush x:Key="CalcButtonFillColorPressedBrush" Color="#FFFFFF" Opacity="0.5" />
          <SolidColorBrush x:Key="CalcButtonFillColorDisabledBrush" Color="#FFFFFF" Opacity="0.125" />
          <SolidColorBrush x:Key="CalcButtonAltFillColorDefaultBrush" Color="#FFFFFF" Opacity="0.5" />
          <SolidColorBrush x:Key="CalcButtonAltFillColorHoverBrush" Color="#FFFFFF" Opacity="0.25" />
          <SolidColorBrush x:Key="CalcButtonAltFillColorPressedBrush" Color="#FFFFFF" Opacity="0.125" />
          <SolidColorBrush x:Key="CalcButtonAltFillColorDisabledBrush" Color="#FFFFFF" Opacity="0.125" />
          <SolidColorBrush x:Key="AppControlHighlightCalcButtonHoverBrush"
                           Color="{DynamicResource SystemAccentColor}"
                           Opacity="0.7" />
          <SolidColorBrush x:Key="AppControlTransparentButtonBackgroundBrush" Color="Transparent" />
          <StaticResource x:Key="AppControlBackgroundTertiaryBrush"
                          ResourceKey="SubtleFillColorTertiaryBrush" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="{x:Static fa:FluentAvaloniaTheme.HighContrastTheme}">
          <StaticResource x:Key="NavigationViewDefaultPaneBackground"
                          ResourceKey="AcrylicInAppFillColorDefaultBrush" />
          <Thickness x:Key="ConverterComboBoxBorderThemeThickness">1</Thickness>
          <StaticResource x:Key="ConverterComboBoxBorderBrush"
                          ResourceKey="SystemControlForegroundBaseMediumLowBrush" />
          <StaticResource x:Key="CalcButtonTextFillColorDefaultBrush"
                          ResourceKey="SystemColorButtonTextColorBrush" />
          <StaticResource x:Key="CalcButtonTextFillColorHoverBrush"
                          ResourceKey="SystemControlHighlightBaseHighBrush" />
          <StaticResource x:Key="CalcButtonTextFillColorPressedBrush"
                          ResourceKey="SystemControlHighlightBaseHighBrush" />
          <StaticResource x:Key="CalcButtonTextFillColorDisabledBrush"
                          ResourceKey="SystemControlDisabledBaseMediumLowBrush" />
          <StaticResource x:Key="CalcButtonFillColorDefaultBrush"
                          ResourceKey="SystemControlBackgroundBaseLowBrush" />
          <StaticResource x:Key="CalcButtonFillColorHoverBrush"
                          ResourceKey="SystemColorHighlightTextColorBrush" />
          <StaticResource x:Key="CalcButtonFillColorPressedBrush"
                          ResourceKey="SystemColorHighlightTextColorBrush" />
          <StaticResource x:Key="CalcButtonFillColorDisabledBrush"
                          ResourceKey="SystemControlBackgroundBaseLowBrush" />
          <StaticResource x:Key="CalcButtonAltFillColorDefaultBrush"
                          ResourceKey="SystemControlBackgroundBaseLowBrush" />
          <StaticResource x:Key="CalcButtonAltFillColorHoverBrush"
                          ResourceKey="SystemColorHighlightTextColorBrush" />
          <StaticResource x:Key="CalcButtonAltFillColorPressedBrush"
                          ResourceKey="SystemColorHighlightTextColorBrush" />
          <StaticResource x:Key="CalcButtonAltFillColorDisabledBrush"
                          ResourceKey="SystemControlBackgroundBaseLowBrush" />
          <StaticResource x:Key="AppControlHighlightCalcButtonHoverBrush"
                          ResourceKey="SystemColorHighlightColorBrush" />
          <SolidColorBrush x:Key="AppControlTransparentButtonBackgroundBrush" Color="Transparent" />
          <StaticResource x:Key="AppControlBackgroundTertiaryBrush"
                          ResourceKey="SystemControlBackgroundTransparentBrush" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <fa:FluentAvaloniaTheme PreferSystemTheme="True"
                            PreferUserAccentColor="True" />
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}" />
      <Setter Property="Background" Value="{DynamicResource ApplicationPageBackgroundThemeBrush}" />
    </Style>
    <Style Selector="UserControl">
      <Setter Property="FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}" />
    </Style>
    <!-- Windows Calculator's OperatorPanelFlyoutStyle is the stock presenter
         with 2 DIPs of content padding and a -3 DIP top overlap. Avalonia's
         stock FlyoutPresenter uses much larger padding, which inflated every
         scientific/programmer popup and shifted its command grid. -->
    <Style Selector="FlyoutPresenter.operator-panel">
      <Setter Property="Padding" Value="2" />
      <Setter Property="Margin" Value="0,-3,0,0" />
      <Setter Property="MaxWidth" Value="Infinity" />
    </Style>
    <!-- Direct Avalonia translation of CalcButtonStyle and its WinUI visual
         states. Keep CalculatorButton's state brushes wired through the
         template: emphasized scientific buttons override these properties. -->
    <Style Selector="controls|CalculatorButton">
      <Setter Property="MinWidth" Value="24" />
      <Setter Property="MinHeight" Value="12" />
      <Setter Property="Margin" Value="1" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Background" Value="{DynamicResource CalcButtonFillColorDefaultBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource CalcButtonTextFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
      <Setter Property="BorderThickness" Value="{DynamicResource ButtonBorderThemeThickness}" />
      <Setter Property="BackgroundSizing" Value="InnerBorderEdge" />
      <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
      <Setter Property="HoverBackground" Value="{DynamicResource CalcButtonFillColorHoverBrush}" />
      <Setter Property="HoverForeground" Value="{DynamicResource CalcButtonTextFillColorHoverBrush}" />
      <Setter Property="PressBackground" Value="{DynamicResource CalcButtonFillColorPressedBrush}" />
      <Setter Property="PressForeground" Value="{DynamicResource CalcButtonTextFillColorPressedBrush}" />
      <Setter Property="DisabledBackground" Value="{DynamicResource CalcButtonFillColorDisabledBrush}" />
      <Setter Property="DisabledForeground" Value="{DynamicResource CalcButtonTextFillColorDisabledBrush}" />
      <Setter Property="Template">
        <ControlTemplate>
          <fac:WinUiBrushBorder x:Name="BackgroundBorder"
                                     TargetBackground="{TemplateBinding Background}"
                                     BorderBrush="{TemplateBinding BorderBrush}"
                                     BorderThickness="{TemplateBinding BorderThickness}"
                                     BackgroundSizing="{TemplateBinding BackgroundSizing}"
                                     CornerRadius="{TemplateBinding CornerRadius}"
                                     TransitionDuration="0:0:0.083">
            <ContentPresenter x:Name="ContentPresenter"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              AutomationProperties.AccessibilityView="Raw"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}" />
          </fac:WinUiBrushBorder>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ fac|WinUiBrushBorder#BackgroundBorder">
        <Setter Property="TargetBackground"
                Value="{Binding HoverBackground, RelativeSource={RelativeSource TemplatedParent}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrushPointerOver}" />
      </Style>
      <Style Selector="^:pointerover /template/ ContentPresenter#ContentPresenter">
        <Setter Property="Foreground"
                Value="{Binding HoverForeground, RelativeSource={RelativeSource TemplatedParent}}" />
      </Style>
      <Style Selector="^:pressed /template/ fac|WinUiBrushBorder#BackgroundBorder">
        <Setter Property="TargetBackground"
                Value="{Binding PressBackground, RelativeSource={RelativeSource TemplatedParent}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrushPressed}" />
      </Style>
      <Style Selector="^:pressed /template/ ContentPresenter#ContentPresenter">
        <Setter Property="Foreground"
                Value="{Binding PressForeground, RelativeSource={RelativeSource TemplatedParent}}" />
      </Style>
      <Style Selector="^:disabled /template/ fac|WinUiBrushBorder#BackgroundBorder">
        <Setter Property="TargetBackground"
                Value="{Binding DisabledBackground, RelativeSource={RelativeSource TemplatedParent}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrushDisabled}" />
      </Style>
      <Style Selector="^:disabled /template/ ContentPresenter#ContentPresenter">
        <Setter Property="Foreground"
                Value="{Binding DisabledForeground, RelativeSource={RelativeSource TemplatedParent}}" />
      </Style>
    </Style>
    <Style Selector="controls|CalculatorButton.numeric">
      <Setter Property="Background" Value="{DynamicResource CalcButtonFillColorDefaultBrush}" />
      <Setter Property="FontSize" Value="24" />
    </Style>
    <Style Selector="controls|CalculatorButton.operator">
      <Setter Property="Background" Value="{DynamicResource CalcButtonAltFillColorDefaultBrush}" />
      <Setter Property="HoverBackground" Value="{DynamicResource CalcButtonAltFillColorHoverBrush}" />
      <Setter Property="PressBackground" Value="{DynamicResource CalcButtonAltFillColorPressedBrush}" />
      <Setter Property="DisabledBackground" Value="{DynamicResource CalcButtonAltFillColorDisabledBrush}" />
    </Style>
    <Style Selector="controls|CalculatorButton.parenthesis">
      <Setter Property="Template">
        <ControlTemplate>
          <Grid>
            <fac:WinUiBrushBorder x:Name="ParenthesisBackgroundBorder"
                                       TargetBackground="{TemplateBinding Background}"
                                       BorderBrush="{TemplateBinding BorderBrush}"
                                       BorderThickness="{TemplateBinding BorderThickness}"
                                       BackgroundSizing="{TemplateBinding BackgroundSizing}"
                                       CornerRadius="{TemplateBinding CornerRadius}"
                                       TransitionDuration="0:0:0.083">
              <ContentPresenter x:Name="ParenthesisContentPresenter"
                                Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                AutomationProperties.AccessibilityView="Raw"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
            </fac:WinUiBrushBorder>
            <TextBlock x:Name="ParenthesisCount"
                       Margin="18,8,0,-8"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="{TemplateBinding MinHeight}"
                       FontWeight="SemiBold"
                       AutomationProperties.AccessibilityView="Raw"
                       Text="{TemplateBinding Tag}" />
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ fac|WinUiBrushBorder#ParenthesisBackgroundBorder">
        <Setter Property="TargetBackground"
                Value="{Binding HoverBackground, RelativeSource={RelativeSource TemplatedParent}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrushPointerOver}" />
      </Style>
      <Style Selector="^:pointerover /template/ ContentPresenter#ParenthesisContentPresenter">
        <Setter Property="Foreground"
                Value="{Binding HoverForeground, RelativeSource={RelativeSource TemplatedParent}}" />
      </Style>
      <Style Selector="^:pointerover /template/ TextBlock#ParenthesisCount">
        <Setter Property="Foreground"
                Value="{Binding HoverForeground, RelativeSource={RelativeSource TemplatedParent}}" />
      </Style>
      <Style Selector="^:pressed /template/ fac|WinUiBrushBorder#ParenthesisBackgroundBorder">
        <Setter Property="TargetBackground"
                Value="{Binding PressBackground, RelativeSource={RelativeSource TemplatedParent}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrushPressed}" />
      </Style>
      <Style Selector="^:pressed /template/ ContentPresenter#ParenthesisContentPresenter">
        <Setter Property="Foreground"
                Value="{Binding PressForeground, RelativeSource={RelativeSource TemplatedParent}}" />
      </Style>
      <Style Selector="^:pressed /template/ TextBlock#ParenthesisCount">
        <Setter Property="Foreground"
                Value="{Binding PressForeground, RelativeSource={RelativeSource TemplatedParent}}" />
      </Style>
      <Style Selector="^:disabled /template/ fac|WinUiBrushBorder#ParenthesisBackgroundBorder">
        <Setter Property="TargetBackground"
                Value="{Binding DisabledBackground, RelativeSource={RelativeSource TemplatedParent}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrushDisabled}" />
      </Style>
      <Style Selector="^:disabled /template/ ContentPresenter#ParenthesisContentPresenter">
        <Setter Property="Foreground"
                Value="{Binding DisabledForeground, RelativeSource={RelativeSource TemplatedParent}}" />
      </Style>
      <Style Selector="^:disabled /template/ TextBlock#ParenthesisCount">
        <Setter Property="Foreground"
                Value="{Binding DisabledForeground, RelativeSource={RelativeSource TemplatedParent}}" />
      </Style>
    </Style>
    <Style Selector="controls|CalculatorButton.symbol">
      <Setter Property="FontFamily" Value="{DynamicResource CalculatorFontFamily}" />
    </Style>
    <!-- CaptionButtonStyle is applied to CalculatorButton instances in the
         memory row. Avalonia's type selector remains active alongside a
         ControlTheme, so mirror the inherited SubtleButtonStyle state brushes
         at the more-specific class selector as well. -->
    <Style Selector="controls|CalculatorButton.caption">
      <Setter Property="Background" Value="{DynamicResource SubtleFillColorTransparentBrush}" />
      <!-- CaptionButtonStyle inherits Calculator's SubtleButtonStyle: normal is
           transparent, then hover/press/disabled use the exact WinUI subtle
           secondary/tertiary/disabled fills. -->
      <Setter Property="HoverBackground" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
      <Setter Property="PressBackground" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
      <Setter Property="DisabledBackground" Value="{DynamicResource SubtleFillColorDisabledBrush}" />
      <Setter Property="HoverForeground" Value="{DynamicResource ButtonForegroundPointerOver}" />
      <Setter Property="PressForeground" Value="{DynamicResource ButtonForegroundPressed}" />
      <Setter Property="DisabledForeground" Value="{DynamicResource ButtonForegroundDisabled}" />
      <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThemeThickness}" />
      <Setter Property="FontSize" Value="16" />
    </Style>
    <Style Selector="controls|CalculatorButton.equals">
      <Setter Property="Background" Value="{DynamicResource AccentButtonBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentButtonForeground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentButtonBorderBrush}" />
      <Setter Property="HoverBackground" Value="{DynamicResource AccentButtonBackgroundPointerOver}" />
      <Setter Property="HoverForeground" Value="{DynamicResource AccentButtonForegroundPointerOver}" />
      <Setter Property="PressBackground" Value="{DynamicResource AccentButtonBackgroundPressed}" />
      <Setter Property="PressForeground" Value="{DynamicResource AccentButtonForegroundPressed}" />
      <Setter Property="DisabledBackground" Value="{DynamicResource AccentButtonBackgroundDisabled}" />
      <Setter Property="DisabledForeground" Value="{DynamicResource AccentButtonForegroundDisabled}" />
      <Setter Property="FontFamily" Value="{DynamicResource CalculatorFontFamily}" />
    </Style>
    <Style Selector="controls|CalculatorButton.equals:pointerover /template/ fac|WinUiBrushBorder#BackgroundBorder">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentButtonBorderBrushPointerOver}" />
    </Style>
    <Style Selector="controls|CalculatorButton.equals:pressed /template/ fac|WinUiBrushBorder#BackgroundBorder">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentButtonBorderBrushPressed}" />
    </Style>
    <Style Selector="controls|CalculatorButton.equals:disabled /template/ fac|WinUiBrushBorder#BackgroundBorder">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentButtonBorderBrushDisabled}" />
    </Style>
    <Style Selector="controls|CalculatorButton.emphasized">
      <Setter Property="HoverBackground" Value="{DynamicResource AppControlHighlightCalcButtonHoverBrush}" />
      <Setter Property="HoverForeground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
      <Setter Property="PressBackground" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
      <Setter Property="PressForeground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
    </Style>
    <!-- Direct Avalonia translation of the original horizontal operator panel controls. -->
    <Style Selector="controls|OperatorPanelButton">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="GlyphFontSize" Value="12" />
      <Setter Property="ChevronFontSize" Value="12" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="MinWidth" Value="32" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource ToggleButtonForeground}" />
      <Setter Property="Background" Value="{DynamicResource SubtleFillColorTransparentBrush}" />
      <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThemeThickness}" />
      <Setter Property="Margin" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
      <Setter Property="Template">
        <ControlTemplate>
          <fac:WinUiBrushBorder x:Name="BackgroundBorder"
                                     TargetBackground="{TemplateBinding Background}"
                                     BorderBrush="{TemplateBinding BorderBrush}"
                                     BorderThickness="{TemplateBinding BorderThickness}"
                                     BackgroundSizing="{TemplateBinding BackgroundSizing}"
                                     CornerRadius="{TemplateBinding CornerRadius}"
                                     TransitionDuration="0:0:0.083">
            <StackPanel Margin="{TemplateBinding Padding}"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
              <TextBlock Margin="0,2,8,0"
                         VerticalAlignment="Center"
                         FontFamily="{DynamicResource CalculatorFontFamily}"
                         FontSize="{TemplateBinding GlyphFontSize}"
                         Text="{TemplateBinding Glyph}" />
              <TextBlock VerticalAlignment="Center"
                         FontSize="{TemplateBinding FontSize}"
                         Text="{TemplateBinding Text}" />
              <TextBlock Margin="8,4,0,0"
                         VerticalAlignment="Center"
                         FontFamily="{DynamicResource CalculatorFontFamily}"
                         FontSize="{TemplateBinding ChevronFontSize}"
                         Text="&#xE70D;" />
            </StackPanel>
          </fac:WinUiBrushBorder>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ToggleButtonBorderBrushPointerOver}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      </Style>
      <Style Selector="^:pressed">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ToggleButtonBorderBrushPressed}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorDisabledBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ToggleButtonBorderBrushDisabled}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
      </Style>
      <Style Selector="^:checked">
        <Setter Property="Background" Value="{DynamicResource AppControlBackgroundTertiaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ToggleButtonBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      </Style>
      <Style Selector="^:checked:pointerover">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ToggleButtonBorderBrushCheckedPointerOver}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      </Style>
      <Style Selector="^:checked:pressed">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ToggleButtonBorderBrushCheckedPressed}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      </Style>
      <Style Selector="^:checked:disabled">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorDisabledBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ToggleButtonBorderBrushCheckedDisabled}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
      </Style>
      <Style Selector="^:indeterminate">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ToggleButtonBorderBrushIndeterminate}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      </Style>
      <Style Selector="^:indeterminate:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource ToggleButtonBorderBrushIndeterminatePointerOver}" />
      </Style>
      <Style Selector="^:indeterminate:pressed">
        <Setter Property="BorderBrush" Value="{DynamicResource ToggleButtonBorderBrushIndeterminatePressed}" />
      </Style>
      <Style Selector="^:indeterminate:disabled">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorDisabledBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ToggleButtonBorderBrushIndeterminateDisabled}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
      </Style>
    </Style>
    <Style Selector="controls|OperatorPanelListView">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </Setter>
      <Setter Property="Template">
        <ControlTemplate>
          <Grid ClipToBounds="True">
            <ScrollViewer x:Name="PART_ScrollViewer"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled">
              <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" />
            </ScrollViewer>
            <Button x:Name="PART_ScrollLeft"
                    Width="32"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Stretch"
                    Padding="0"
                    IsVisible="False"
                    FontFamily="{DynamicResource CalculatorFontFamily}"
                    Content="&#xE76B;" />
            <Button x:Name="PART_ScrollRight"
                    Width="32"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    Padding="0"
                    IsVisible="False"
                    FontFamily="{DynamicResource CalculatorFontFamily}"
                    Content="&#xE76C;" />
          </Grid>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="controls|RadixButton.radix">
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}">
            <Grid ColumnDefinitions="3,44,*">
              <Border x:Name="SelectionIndicator"
                      Width="3" Height="14"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      CornerRadius="2" />
              <TextBlock Grid.Column="1"
                         Margin="8,0,4,0"
                         VerticalAlignment="Center"
                         FontSize="11"
                         Text="{TemplateBinding Tag}" />
              <TextBlock Grid.Column="2"
                         Margin="4,0"
                         VerticalAlignment="Center"
                         Text="{TemplateBinding Content}" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="controls|RadixButton.radix:checked /template/ Border#SelectionIndicator">
      <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
    </Style>
    <Style Selector="controls|FlipButtons">
      <Setter Property="Margin" Value="1" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="12" />
      <Setter Property="MinHeight" Value="20" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="controls|FlipButtons:checked">
      <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorTertiaryBrush}" />
    </Style>

    <!-- RESULTS: direct translation of CalculationResultStyle and ResultsScrollerSnapped. -->
    <Style Selector="controls|CalculationResult">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Right" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid Background="{TemplateBinding Background}"
                FlowDirection="LeftToRight"
                ColumnDefinitions="12,*,12">
            <ScrollViewer x:Name="TextContainer"
                          Grid.Column="1"
                          Padding="0"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled"
                          HorizontalContentAlignment="Right"
                          AutomationProperties.AccessibilityView="Raw">
              <SelectableTextBlock x:Name="NormalOutput"
                                   Margin="{TemplateBinding DisplayMargin}"
                                   IsTabStop="False"
                                   HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                   VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   FontSize="{TemplateBinding FontSize}"
                                   FontWeight="Light"
                                   AutomationProperties.AccessibilityView="Raw"
                                   TextAlignment="Right"
                                   TextWrapping="NoWrap" />
            </ScrollViewer>
            <Button x:Name="ScrollLeft"
                    Grid.Column="0"
                    Width="20"
                    MinWidth="20"
                    MinHeight="24"
                    Margin="-4,0"
                    Padding="0,-3,0,4"
                    VerticalAlignment="Top"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Foreground="{DynamicResource AccentTextFillColorTertiaryBrush}"
                    Background="Transparent"
                    BorderThickness="0"
                    AutomationProperties.AutomationId="CalculationResultScrollLeft"
                    AutomationProperties.Name="{utils:ResourceString Name='CalculationResultScrollLeft.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name'}"
                    IsVisible="False">
              <TextBlock FontFamily="{DynamicResource CalculatorFontFamily}"
                         FontSize="12"
                         Text="&#xE96F;" />
            </Button>
            <Button x:Name="ScrollRight"
                    Grid.Column="2"
                    Width="20"
                    MinWidth="20"
                    MinHeight="24"
                    Margin="-4,0"
                    Padding="0,-3,0,4"
                    VerticalAlignment="Top"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Foreground="{DynamicResource AccentTextFillColorTertiaryBrush}"
                    Background="Transparent"
                    BorderThickness="0"
                    AutomationProperties.AutomationId="CalculationResultScrollRight"
                    AutomationProperties.Name="{utils:ResourceString Name='CalculationResultScrollRight.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name'}"
                    IsVisible="False">
              <TextBlock FontFamily="{DynamicResource CalculatorFontFamily}"
                         FontSize="12"
                         Text="&#xE970;" />
            </Button>
          </Grid>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="controls|CalculationResult.converterValue /template/ SelectableTextBlock#NormalOutput">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="TextAlignment" Value="Left" />
    </Style>

    <!-- EXPRESSION: direct translation of NormalStyle. -->
    <Style Selector="controls|OverflowTextBlock">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid Background="{TemplateBinding Background}"
                FlowDirection="LeftToRight"
                ColumnDefinitions="12,*,12">
            <ScrollViewer x:Name="ExpressionContainer"
                          Grid.Column="1"
                          Padding="0"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled"
                          AutomationProperties.AccessibilityView="Raw">
              <Grid x:Name="ExpressionContent">
                <ItemsControl x:Name="TokenList"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Stretch"
                              Focusable="False"
                              ItemTemplate="{TemplateBinding ItemTemplate}"
                              ItemsSource="{TemplateBinding ItemsSource}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel HorizontalAlignment="Right"
                                  VerticalAlignment="Stretch"
                                  Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
              </Grid>
            </ScrollViewer>
            <Button x:Name="ScrollLeft"
                    Grid.Column="0"
                    Theme="{StaticResource ScrollButtonStyle}"
                    Width="20"
                    Height="20"
                    Margin="-4,3,-4,0"
                    Padding="0"
                    VerticalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    BorderThickness="0"
                    AutomationProperties.Name="{utils:ResourceString Name='scrollLeft.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name'}"
                    IsVisible="False">
              <TextBlock FontFamily="{DynamicResource CalculatorFontFamily}"
                         FontSize="12"
                         Text="&#xE96F;" />
            </Button>
            <Button x:Name="ScrollRight"
                    Grid.Column="2"
                    Theme="{StaticResource ScrollButtonStyle}"
                    Width="20"
                    Height="20"
                    Margin="-4,3,-4,0"
                    Padding="0"
                    VerticalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    BorderThickness="0"
                    AutomationProperties.Name="{utils:ResourceString Name='scrollRight.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name'}"
                    IsVisible="False">
              <TextBlock FontFamily="{DynamicResource CalculatorFontFamily}"
                         FontSize="12"
                         Text="&#xE970;" />
            </Button>
          </Grid>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="controls|OverflowTextBlock.alwaysOnTop">
      <Setter Property="Template">
        <ControlTemplate>
          <Grid Background="{TemplateBinding Background}"
                FlowDirection="LeftToRight"
                ColumnDefinitions="Auto,*,Auto">
            <ScrollViewer x:Name="ExpressionContainer"
                          Grid.ColumnSpan="3"
                          Padding="0"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled"
                          AutomationProperties.AccessibilityView="Control">
              <Grid x:Name="ExpressionContent">
                <TextBlock Margin="4,0"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Stretch"
                           FontWeight="SemiBold"
                           AutomationProperties.AccessibilityView="Raw"
                           Text="{TemplateBinding DisplayValue}" />
              </Grid>
            </ScrollViewer>
            <Button x:Name="ScrollLeft"
                    Grid.Column="0"
                    Width="{TemplateBinding ScrollButtonsWidth}"
                    Margin="0,3,0,0"
                    Padding="0"
                    VerticalAlignment="Stretch"
                    Background="Transparent"
                    BorderThickness="0"
                    AutomationProperties.Name="{utils:ResourceString Name='scrollLeft.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name'}"
                    IsVisible="False">
              <TextBlock FontFamily="{DynamicResource CalculatorFontFamily}"
                         FontSize="{TemplateBinding ScrollButtonsFontSize}"
                         Text="&#xE96F;" />
            </Button>
            <Button x:Name="ScrollRight"
                    Grid.Column="2"
                    Width="{TemplateBinding ScrollButtonsWidth}"
                    Margin="0,3,0,0"
                    Padding="0"
                    VerticalAlignment="Stretch"
                    Background="Transparent"
                    BorderThickness="0"
                    AutomationProperties.Name="{utils:ResourceString Name='scrollRight.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name'}"
                    IsVisible="False">
              <TextBlock FontFamily="{DynamicResource CalculatorFontFamily}"
                         FontSize="{TemplateBinding ScrollButtonsFontSize}"
                         Text="&#xE970;" />
            </Button>
          </Grid>
        </ControlTemplate>
      </Setter>
    </Style>
  </Application.Styles>
</Application>
