<Application x:Class="CalculatorApp.App"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:CalculatorApp.Controls"
             xmlns:fa="using:FluentAvalonia.Styling"
             xmlns:fac="using:FluentAvalonia.UI.Controls"
             xmlns:utils="using:CalculatorApp.Utils"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Controls/SwipeControlStyles.xaml" />
        <ResourceInclude Source="/Controls/CalculatorToggleButtonThemes.xaml" />
        <ResourceInclude Source="/Controls/HistoryMemoryStyles.xaml" />
        <ResourceInclude Source="/Views/DelighterUnitStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <FontFamily x:Key="CalculatorFontFamily">avares://Calculator/Assets/CalculatorIcons.ttf#Calculator Fluent Icons</FontFamily>
      <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI Variable,Segoe UI,avares://Calculator/Assets/Fonts/Hind2#Hind2,sans-serif</FontFamily>
      <FontFamily x:Key="CurrencySymbolFontFamily">Segoe UI Variable,Segoe UI,avares://Calculator/Assets/Fonts/Hind2#Hind2,sans-serif</FontFamily>

      <!-- Original Calculator overrides for WinUI's NavigationView resources.
           Keep the content transparent so the application/Mica fallback shows
           through, remove the minimal-mode separator inset, and retain the
           acrylic pane resource with FluentAvalonia's deterministic fallback. -->
      <StaticResource x:Key="NavigationViewContentBackground"
                      ResourceKey="SystemControlTransparentBrush" />
      <Thickness x:Key="NavigationViewContentPresenterMargin">0</Thickness>
      <Thickness x:Key="NavigationViewMinimalContentGridBorderThickness">0</Thickness>

