<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>CalculatorApp</RootNamespace>
    <AssemblyName>Calculator</AssemblyName>
    <ApplicationTitle>Calculator</ApplicationTitle>
    <Product>Calculator</Product>
    <Authors>jmacato</Authors>
    <Company>jmacato</Company>
    <Version>1.0.0</Version>
    <ApplicationVersion>1.0.0</ApplicationVersion>
    <ApplicationId>io.github.jmacato.calculator</ApplicationId>
    <NeutralLanguage>en-US</NeutralLanguage>

    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <EnableDefaultAvaloniaItems>false</EnableDefaultAvaloniaItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CalculatorBrowserBuild)' == 'true'">
    <DefineConstants>$(DefineConstants);CALCULATOR_BROWSER</DefineConstants>
    <!-- Keep the browser-flavored assembly isolated from normal desktop builds.
         This also avoids two project instances racing over the same outputs in
         a solution/CI build that contains both front ends. -->
    <IntermediateOutputPath>obj/browser/$(Configuration)/</IntermediateOutputPath>
    <OutputPath>bin/browser/$(Configuration)/</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CalculatorBrowserBuild)' == 'true' and '$(CalcEnableThreadedManagedDebugging)' == 'true'">
    <DefineConstants>$(DefineConstants);CALCULATOR_THREADED_MANAGED_DEBUG</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Vendor\**\*.cs" />
    <Compile Remove="MainWindow.xaml.cs;Views\TitleBar.xaml.cs"
             Condition="'$(CalculatorBrowserBuild)' == 'true'" />
    <AvaloniaXaml Remove="**\*.axaml" />
    <AvaloniaXaml Remove="**\*.xaml" />
    <AvaloniaXaml Include="App.xaml" />
    <AvaloniaXaml Include="MainWindow.xaml"
                  Condition="'$(CalculatorBrowserBuild)' != 'true'" />
    <AvaloniaXaml Include="Views\Calculator.xaml" />
    <AvaloniaXaml Include="Views\CalculatorStandardOperators.xaml" />
    <AvaloniaXaml Include="Views\CalculatorScientificOperators.xaml" />
    <AvaloniaXaml Include="Views\CalculatorScientificAngleButtons.xaml" />
    <AvaloniaXaml Include="Views\CalculatorProgrammerDisplayPanel.xaml" />
    <AvaloniaXaml Include="Views\CalculatorProgrammerBitFlipPanel.xaml" />
    <AvaloniaXaml Include="Views\CalculatorProgrammerOperators.xaml" />
    <AvaloniaXaml Include="Views\CalculatorProgrammerRadixOperators.xaml" />
    <AvaloniaXaml Include="Views\DateCalculator.xaml" />
    <AvaloniaXaml Include="Views\UnitConverter.xaml" />
    <AvaloniaXaml Include="Views\PreferencesPage.xaml" />
    <AvaloniaXaml Include="Views\GraphingCalculator\GraphingCalculator.xaml" />
    <AvaloniaXaml Include="Views\GraphingCalculator\EquationInputArea.xaml" />
    <AvaloniaXaml Include="Views\GraphingCalculator\GraphingNumPad.xaml" />
    <AvaloniaXaml Include="Views\GraphingCalculator\GraphingSettings.xaml" />
    <AvaloniaXaml Include="Views\GraphingCalculator\EquationStylePanelControl.xaml" />
    <AvaloniaXaml Include="Views\GraphingCalculator\KeyGraphFeaturesPanel.xaml" />
    <AvaloniaXaml Include="Views\HistoryList.xaml" />
    <AvaloniaXaml Include="Views\Memory.xaml" />
    <AvaloniaXaml Include="Views\MemoryListItem.xaml" />
    <AvaloniaXaml Include="Views\NumberPad.xaml" />
    <AvaloniaXaml Include="Views\OperatorsPanel.xaml" />
    <AvaloniaXaml Include="Views\SupplementaryResults.xaml" />
    <AvaloniaXaml Include="Views\TitleBar.xaml"
                  Condition="'$(CalculatorBrowserBuild)' != 'true'" />
    <AvaloniaXaml Include="Views\DelighterUnitStyles.xaml" />
    <AvaloniaXaml Include="Controls\SwipeControlStyles.xaml" />
    <AvaloniaXaml Include="Controls\HistoryMemoryStyles.xaml" />
    <AvaloniaXaml Include="Controls\CalculatorToggleButtonThemes.xaml" />
    <AvaloniaXaml Include="Views\MainPage.xaml" />
    <AvaloniaResource Include="Assets\Fonts\Hind2\**\*.ttf" />
    <AvaloniaResource Include="Assets\Fonts\NotoSans\NotoSans-Currency.ttf"
                      Condition="'$(CalculatorBrowserBuild)' == 'true'" />
    <AvaloniaResource Include="Assets\CalculatorIcons.ttf" />
    <AvaloniaResource Include="Assets\CalculatorAppList.targetsize-20.png" />
    <EmbeddedResource Include="Resources\*.resx" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GraphControl\GraphControl.csproj"
                      GlobalPropertiesToRemove="PublishAot;PublishTrimmed;SelfContained;RuntimeIdentifier;CalculatorBrowserBuild" />
    <ProjectReference Include="..\CalcManagerManaged\CalcManagerPort\CalcManagerPort.csproj"
                      GlobalPropertiesToRemove="PublishAot;PublishTrimmed;SelfContained;RuntimeIdentifier;CalculatorBrowserBuild" />
    <ProjectReference Include="Vendor\FluentAvalonia\FluentAvalonia.csproj"
                      GlobalPropertiesToRemove="PublishAot;PublishTrimmed;SelfContained;RuntimeIdentifier;CalculatorBrowserBuild" />
    <ProjectReference Include="Vendor\MathComposer\src\MathComposer.Core\MathComposer.Core.csproj"
                      GlobalPropertiesToRemove="PublishAot;PublishTrimmed;SelfContained;RuntimeIdentifier;CalculatorBrowserBuild" />
    <ProjectReference Include="Vendor\MathComposer\src\MathComposer.Avalonia\MathComposer.Avalonia.csproj"
                      GlobalPropertiesToRemove="PublishAot;PublishTrimmed;SelfContained;RuntimeIdentifier;CalculatorBrowserBuild" />
  </ItemGroup>
</Project>
