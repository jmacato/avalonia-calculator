<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="CalcManagerManagedTests" />
    </ItemGroup>

    <ItemGroup Condition="Exists('bin/$(Configuration)/$(TargetFramework)/libCalcManager.dylib')">
        <None Include="bin/$(Configuration)/$(TargetFramework)/libCalcManager.dylib"
              Link="libCalcManager.dylib"
              CopyToOutputDirectory="PreserveNewest"
              Visible="false" />
    </ItemGroup>

    <!-- Native production builds opt in explicitly. Repository-wide managed
         validation must not depend on a host-specific CMake toolchain. -->
    <Target Name="BuildNative" BeforeTargets="BeforeBuild" Condition="'$(BuildCalcManagerNative)' == 'true'">
        <Message Text="Building native code with CMake..." Importance="high" />
        <Exec Command="cd $(MSBuildThisFileDirectory)../../../build &amp;&amp; cmake ../src &amp;&amp; make" />
    </Target>
</Project>
