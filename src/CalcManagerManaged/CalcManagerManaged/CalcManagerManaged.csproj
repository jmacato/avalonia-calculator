<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
    </ItemGroup>

    <!-- Build CMake project before building C# project -->
    <Target Name="BuildNative" BeforeTargets="BeforeBuild">
        <Message Text="Building native code with CMake..." Importance="high" />
        <Exec Command="cd $(MSBuildThisFileDirectory)../../../build &amp;&amp; cmake ../src &amp;&amp; make" />
    </Target>
</Project>
