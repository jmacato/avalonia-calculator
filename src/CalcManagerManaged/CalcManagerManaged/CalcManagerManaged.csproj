<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="CalcManagerManagedTests" />
    </ItemGroup>

    <ItemGroup>
        <None Include="bin/$(Configuration)/$(TargetFramework)/libCalcManager.dylib"
              Link="libCalcManager.dylib"
              CopyToOutputDirectory="PreserveNewest"
              Visible="false" />
    </ItemGroup>

    <!-- Build CMake project before building C# project -->
    <Target Name="BuildNative" BeforeTargets="BeforeBuild">
        <Message Text="Building native code with CMake..." Importance="high" />
        <Exec Command="cd $(MSBuildThisFileDirectory)../../../build &amp;&amp; cmake ../src &amp;&amp; make" />
    </Target>
</Project>
