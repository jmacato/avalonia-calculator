<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0-browser</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Keep the managed-debuggable build single-threaded. Release uses the
         threaded compositor/runtime path and profile-guided managed AOT. Full
         managed AOT is deliberately unsupported here: its monolithic module
         raises WebKit's WebContent footprint by roughly one gigabyte. -->
    <WasmEnableThreads Condition="'$(Configuration)' == 'Release'">true</WasmEnableThreads>
    <WasmEnableThreads Condition="'$(Configuration)' != 'Release'">false</WasmEnableThreads>
    <!-- Browser background work is channel-based and bounded. A single portable
         thread-pool worker services it without leaving one full WebAssembly/
         JavaScriptCore worker resident per reported processor. -->
    <ThreadPoolMinThreads Condition="'$(Configuration)' == 'Release'">1</ThreadPoolMinThreads>
    <ThreadPoolMaxThreads Condition="'$(Configuration)' == 'Release'">1</ThreadPoolMaxThreads>
    <WasmEnableSIMD Condition="'$(Configuration)' == 'Release'">true</WasmEnableSIMD>
    <!-- This is an application artifact, not a hot-reload development host.
         Keeping the implicit initializer in the restored graph adds a script
         evaluation and static assets even when Release disables hot reload. -->
    <WasmEnableHotReload>false</WasmEnableHotReload>
    <ShouldIncludeNativeSkiaSharp Condition="'$(Configuration)' == 'Release'">false</ShouldIncludeNativeSkiaSharp>
    <EmccStackSize>1MB</EmccStackSize>
    <!-- Keep threaded runtime registration inside the initial allocation. Growing
         shared memory while worker instances register can leave stale bounds on
         WebKit. -->
    <WasmInitialHeapSize Condition="'$(Configuration)' == 'Release'">109051904</WasmInitialHeapSize>
    <!-- This is a growth ceiling, not committed memory. Telemetry reached the
         former 200 MiB ceiling exactly while only 143 MiB was live in malloc;
         Emscripten could not reserve the GC's next 16 KiB major-heap section. -->
    <EmccMaximumHeapSize Condition="'$(Configuration)' == 'Release'">536870912</EmccMaximumHeapSize>
    <!-- Profile collection and shipping builds must link the same native Skia/
         Graphite capabilities so the recorded workload matches Release. -->
    <_CalculatorEmdawnWebGpuPort>$([MSBuild]::NormalizePath($(MSBuildProjectDirectory), 'Native', 'EmdawnWebGpu', 'emdawnwebgpu.port.py'))</_CalculatorEmdawnWebGpuPort>
    <EmccExtraLDFlags Condition="'$(Configuration)' == 'Release'">$(EmccExtraLDFlags) -sUSE_WEBGL2=1 -sDEFAULT_TO_CXX=1 -sTEXTDECODER=1 --use-port=&quot;$(_CalculatorEmdawnWebGpuPort)&quot; -sMEMORY_GROWTH_GEOMETRIC_STEP=0 -sMEMORY_GROWTH_LINEAR_STEP=4194304</EmccExtraLDFlags>
    <DefineConstants Condition="'$(Configuration)' == 'Release'">$(DefineConstants);CALC_WEBGPU</DefineConstants>
    <InvariantTimezone>true</InvariantTimezone>
    <EventSourceSupport>true</EventSourceSupport>
    <!-- Compile observed hot methods and retain the interpreter for every other
         method. Release AOT is a shipping requirement; do not disable it to work
         around missing profile-only interpreter entry wrappers. -->
    <CalculatorBrowserProfiledAot Condition="'$(CalculatorBrowserProfiledAot)' == '' and '$(Configuration)' == 'Release' and '$(CollectAotProfile)' != 'true'">true</CalculatorBrowserProfiledAot>
    <CalculatorBrowserProfiledAot Condition="'$(CalculatorBrowserProfiledAot)' == ''">false</CalculatorBrowserProfiledAot>
    <RunAOTCompilation Condition="'$(RunAOTCompilation)' == '' and '$(CalculatorBrowserProfiledAot)' == 'true'">true</RunAOTCompilation>
    <RunAOTCompilation Condition="'$(RunAOTCompilation)' == ''">false</RunAOTCompilation>
    <!-- Keep browser artifacts directly serveable by any static host. The app
         shell is small, while precompressed-only outputs make identity
         negotiation fragile and complicate reproducible verification. -->
    <CompressionEnabled>false</CompressionEnabled>
    <_WebAssemblyUserRunParameters>true</_WebAssemblyUserRunParameters>
    <_CalculatorBrowserHostProject>$([MSBuild]::NormalizePath($(MSBuildProjectDirectory), '..', '..', 'Tools', 'Calculator.BrowserHost', 'Calculator.BrowserHost.csproj'))</_CalculatorBrowserHostProject>
    <_CalculatorBrowserStaticWebAssetsManifest>$([MSBuild]::NormalizePath($(MSBuildProjectDirectory), 'bin', '$(Configuration)', '$(TargetFramework)', '$(AssemblyName).staticwebassets.runtime.json'))</_CalculatorBrowserStaticWebAssetsManifest>
    <RunCommand Condition="'$(DOTNET_HOST_PATH)' != '' and Exists('$(DOTNET_HOST_PATH)')">$(DOTNET_HOST_PATH)</RunCommand>
    <RunCommand Condition="'$(DOTNET_HOST_PATH)' == '' or !Exists('$(DOTNET_HOST_PATH)')">dotnet</RunCommand>
    <RunArguments>run --project &quot;$(_CalculatorBrowserHostProject)&quot; --configuration &quot;$(Configuration)&quot; --no-launch-profile -- &quot;$(_CalculatorBrowserStaticWebAssetsManifest)&quot;</RunArguments>
    <RunWorkingDirectory>$(MSBuildProjectDirectory)</RunWorkingDirectory>
    <!-- Several graph projects converge on the same vendored Avalonia projects.
         Serial project-reference builds prevent duplicate XAML compilers from
         rewriting the same output while dotnet run builds this entry point. -->
    <BuildInParallel>false</BuildInParallel>
    <_CalculatorStockSkiaArchive>$([MSBuild]::NormalizePath($(MSBuildProjectDirectory), 'Native', 'libSkiaSharp.a'))</_CalculatorStockSkiaArchive>
    <_CalculatorGraphiteWebGpuArchive>$([MSBuild]::NormalizePath($(MSBuildProjectDirectory), 'Native', 'libCalcNeoGraphiteWebGpu.a'))</_CalculatorGraphiteWebGpuArchive>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CollectAotProfile)' == 'true'">
    <RunAOTCompilation>false</RunAOTCompilation>
    <WasmEnableThreads>true</WasmEnableThreads>
    <WasmProfilers>aot</WasmProfilers>
    <EnableDiagnostics>false</EnableDiagnostics>
    <_TrimmerShowRedundantSuppressions>false</_TrimmerShowRedundantSuppressions>
    <DefineConstants>$(DefineConstants);COLLECT_AOT_PROFILE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(CollectAotProfile)' != 'true'">
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <CalculatorBrowserAotProfilePath Condition="'$(CalculatorBrowserAotProfilePath)' == ''">$(MSBuildThisFileDirectory)Profiles/Calculator.aotprofile</CalculatorBrowserAotProfilePath>
    <WasmAotProfilePath Condition="'$(RunAOTCompilation)' == 'true'">$(CalculatorBrowserAotProfilePath)</WasmAotProfilePath>
    <AOTMode Condition="'$(RunAOTCompilation)' == 'true'">LLVMOnlyInterp</AOTMode>
    <!-- Mono 10's cross-assembly generic dedup pass emits some profiled generic
         instances both in their owning assembly and aot-instances.dll. Keep
         each profiled instance with its owner until that linker defect is fixed. -->
    <WasmDedup Condition="'$(RunAOTCompilation)' == 'true'">false</WasmDedup>
    <WasmStripILAfterAOT Condition="'$(RunAOTCompilation)' == 'true'">true</WasmStripILAfterAOT>
    <WasmStripILAfterAOT Condition="'$(RunAOTCompilation)' != 'true'">false</WasmStripILAfterAOT>
    <WasmNativeDebugSymbols>false</WasmNativeDebugSymbols>
    <WasmNativeStrip>true</WasmNativeStrip>
    <WasmEmitSymbolMap>false</WasmEmitSymbolMap>
    <WasmEmitSourceMap>false</WasmEmitSourceMap>
    <WasmRunWasmOpt>true</WasmRunWasmOpt>
    <EmccCompileOptimizationFlag Condition="'$(RunAOTCompilation)' == 'true'">-O2</EmccCompileOptimizationFlag>
    <WasmBitcodeCompileOptimizationFlag Condition="'$(RunAOTCompilation)' == 'true'">-O2</WasmBitcodeCompileOptimizationFlag>
    <EmccLinkOptimizationFlag Condition="'$(RunAOTCompilation)' == 'true'">-O2</EmccLinkOptimizationFlag>
    <EmccCompileOptimizationFlag Condition="'$(RunAOTCompilation)' != 'true'">-O3</EmccCompileOptimizationFlag>
    <WasmBitcodeCompileOptimizationFlag Condition="'$(RunAOTCompilation)' != 'true'">-O3</WasmBitcodeCompileOptimizationFlag>
    <EmccLinkOptimizationFlag Condition="'$(RunAOTCompilation)' != 'true'">-O3</EmccLinkOptimizationFlag>
    <EnableDiagnostics>false</EnableDiagnostics>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
    <!-- Avalonia.Base 9999.0.0-localbuild contains two now-redundant IL2070/
         IL2075 suppression attributes. Ignore only IL2121 (the redundant-
         suppression diagnostic); all substantive linker warnings stay fatal. -->
    <_TrimmerShowRedundantSuppressions>false</_TrimmerShowRedundantSuppressions>
  </PropertyGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Release' and '$(CollectAotProfile)' != 'true'">
    <!-- Keep managed retention bounded independently of the native/WASM growth
         ceiling. This leaves room for Skia surfaces without teaching the GC
         that it may retain the entire 512 MiB linear memory. -->
    <RuntimeHostConfigurationOption Include="System.GC.HeapHardLimit" Value="134217728" />
    <WasmOptConfigurationFlags Include="-O2" Condition="'$(RunAOTCompilation)' == 'true'" />
    <WasmOptConfigurationFlags Include="-O3" Condition="'$(RunAOTCompilation)' != 'true'" />
    <WasmOptConfigurationFlags Include="--merge-similar-functions" />
    <WasmOptConfigurationFlags Include="--duplicate-function-elimination" />
    <!-- Stock Skia m150 uses saturating float-to-integer conversions. Keep the
         feature declaration with the application link instead of modifying the
         installed .NET workload's post-link wasm-opt command. -->
    <WasmOptConfigurationFlags Include="--enable-nontrapping-float-to-int" />
    <EmccExportedRuntimeMethod Include="WebGPU" />
    <EmccExportedFunction Include="_sk_graphite_webgpu_context_create" />
  </ItemGroup>

  <Target Name="ValidateCalculatorBrowserAotProfile"
          BeforeTargets="_WasmAotCompileApp"
          Condition="'$(RunAOTCompilation)' == 'true'">
    <Error Condition="'$(AOTMode)' != 'LLVMOnlyInterp'"
           Text="Calculator browser AOT must use LLVMOnlyInterp so methods outside the profile retain an interpreter fallback." />
    <Error Condition="'$(WasmAotProfilePath)' == '' or !Exists('$(WasmAotProfilePath)')"
           Text="Calculator browser profiled AOT requires an existing WasmAotProfilePath. Full unprofiled AOT is not permitted." />
    <Message Importance="High"
             Text="Building Calculator browser with profile-guided hybrid AOT: $(WasmAotProfilePath)" />
  </Target>

  <Target Name="ValidateCalculatorWebGpuInputs"
          BeforeTargets="_PrepareForBrowserWasmBuildNative"
          Condition="'$(Configuration)' == 'Release'">
    <Error Condition="'$(EmscriptenVersion)' != '3.1.56'"
           Text="Calculator WebGPU native inputs were built with the .NET 10.0.8 workload's Emscripten 3.1.56 toolchain; the active workload reports $(EmscriptenVersion)." />
    <Error Condition="!Exists('$(_CalculatorEmdawnWebGpuPort)')"
           Text="CalcNeo's Emdawnwebgpu port is missing. Run eng/browser/build-skia-webgpu.sh first." />
    <Error Condition="!Exists('$(_CalculatorStockSkiaArchive)')"
           Text="CalcNeo's stock Skia archive is missing. Run eng/browser/build-skia-webgpu.sh first." />
    <Error Condition="!Exists('$(_CalculatorGraphiteWebGpuArchive)')"
           Text="CalcNeo's Graphite/WebGPU bridge is missing. Run eng/browser/build-skia-webgpu.sh first." />
  </Target>

  <Target Name="ValidateCalculatorBrowserAotNativeSize"
          AfterTargets="_CompleteWasmBuildNative"
          Condition="'$(Configuration)' == 'Release' and '$(CollectAotProfile)' != 'true' and '$(RunAOTCompilation)' == 'true'">
    <PropertyGroup>
      <!-- The current representative profile produces a 20.41 MiB module
           without Mono's broken generic-dedup pass. Preserve narrow growth room
           while rejecting the former 84+ MiB full-AOT module before publish. -->
      <CalculatorBrowserMaxNativeWasmBytes Condition="'$(CalculatorBrowserMaxNativeWasmBytes)' == ''">23068672</CalculatorBrowserMaxNativeWasmBytes>
      <_CalculatorAotNativeWasmPath>$(_WasmIntermediateOutputPath)dotnet.native.wasm</_CalculatorAotNativeWasmPath>
      <_CalculatorEmscriptenNode>$([MSBuild]::NormalizePath($(EmscriptenNodeToolsPath), 'bin', 'node$(_ExeExt)'))</_CalculatorEmscriptenNode>
      <_CalculatorNativeSizeValidator>$([MSBuild]::NormalizePath($(MSBuildProjectDirectory), '..', '..', 'eng', 'browser', 'validate-native-wasm-size.mjs'))</_CalculatorNativeSizeValidator>
    </PropertyGroup>
    <Exec Command="&quot;$(_CalculatorEmscriptenNode)&quot; &quot;$(_CalculatorNativeSizeValidator)&quot; &quot;$(_CalculatorAotNativeWasmPath)&quot; &quot;$(CalculatorBrowserMaxNativeWasmBytes)&quot;" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia.Browser" Version="9999.0.0-localbuild" />
    <TrimmerRootDescriptor Include="ILLink.Descriptors.xml" Condition="'$(WasmEnableThreads)' == 'true'" />
    <NativeFileReference Include="Native/mono-satellite-loader.c"
                         Condition="'$(Configuration)' == 'Release' and '$(CollectAotProfile)' != 'true'" />
    <NativeFileReference Include="Native/dotnet-emscripten-sjlj-compat.c"
                         Condition="'$(Configuration)' == 'Release'" />
    <NativeFileReference Include="$(_CalculatorStockSkiaArchive)"
                         Condition="'$(Configuration)' == 'Release'" />
    <NativeFileReference Include="$(_CalculatorGraphiteWebGpuArchive)"
                         Condition="'$(Configuration)' == 'Release'" />
    <NativeFileReference Include="Native/sk_graphite_webgpu_stubs.c"
                         Condition="'$(Configuration)' != 'Release'" />
    <EmccExportedFunction Include="_calc_browser_load_configured_satellite"
                          Condition="'$(Configuration)' == 'Release' and '$(CollectAotProfile)' != 'true'" />
    <EmccExportedFunction Include="_calc_browser_get_satellite_load_status"
                          Condition="'$(Configuration)' == 'Release' and '$(CollectAotProfile)' != 'true'" />
    <NativeFileReference Include="Native/mono-aot-debugger-bootstrap.c"
                         Condition="'$(CalcEnableThreadedManagedDebugging)' == 'true'" />
    <_AOT_InternalForceInterpretAssemblies Include="Calculator"
                                           Condition="'$(CalcInterpretManagedDebugAssemblies)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Calculator\Calculator.csproj"
                      AdditionalProperties="CalculatorBrowserBuild=true;CalcEnableThreadedManagedDebugging=$(CalcEnableThreadedManagedDebugging)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Calculator\Assets\Fonts\Hind2\Hind2-Regular.ttf"
             Link="wwwroot\fonts\Hind2-Regular.ttf"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\Calculator\Assets\Fonts\Hind2\Hind2-SemiBold.ttf"
             Link="wwwroot\fonts\Hind2-SemiBold.ttf"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\Calculator\Assets\Fonts\Hind2\LICENSE.txt"
             Link="wwwroot\fonts\Hind2-LICENSE.txt"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="GenerateCalculatorBrowserBuildDownloadManifest"
          BeforeTargets="GenerateStaticWebAssetsManifest"
          DependsOnTargets="_AddWasmStaticWebAssets"
          Condition="'@(WasmStaticWebAsset)' != ''">
    <PropertyGroup>
      <_CalculatorBrowserBuildDownloadManifestPath>$(IntermediateOutputPath)browser-asset-sizes.build.js</_CalculatorBrowserBuildDownloadManifestPath>
    </PropertyGroup>
    <ItemGroup>
      <_CalculatorBrowserBuildDownloadAsset Include="@(WasmStaticWebAsset)"
                                            Condition="'%(AssetTraitName)' == 'WasmResource' or '%(AssetTraitName)' == 'Culture'" />
      <_CalculatorBrowserBuildDownloadManifestCandidate Include="$(_CalculatorBrowserBuildDownloadManifestPath)"
                                                        RelativePath="browser-asset-sizes.js" />
    </ItemGroup>
    <WriteLinesToFile File="$(_CalculatorBrowserBuildDownloadManifestPath)"
                      Lines="export const assetSizes = new Map(["
                      Overwrite="true"
                      Encoding="UTF-8" />
    <WriteLinesToFile File="$(_CalculatorBrowserBuildDownloadManifestPath)"
                      Lines="@(_CalculatorBrowserBuildDownloadAsset->'  [&quot;%(Filename)%(Extension)&quot;, %(FileLength)],')"
                      Overwrite="false"
                      Encoding="UTF-8" />
    <WriteLinesToFile File="$(_CalculatorBrowserBuildDownloadManifestPath)"
                      Lines="]);"
                      Overwrite="false"
                      Encoding="UTF-8" />
    <DefineStaticWebAssets CandidateAssets="@(_CalculatorBrowserBuildDownloadManifestCandidate)"
                           SourceId="$(PackageId)"
                           SourceType="Computed"
                           AssetKind="Build"
                           AssetRole="Primary"
                           CopyToOutputDirectory="PreserveNewest"
                           CopyToPublishDirectory="Never"
                           ContentRoot="$(OutDir)wwwroot"
                           BasePath="$(StaticWebAssetBasePath)">
      <Output TaskParameter="Assets" ItemName="_CalculatorBrowserBuildDownloadManifestAsset" />
    </DefineStaticWebAssets>
    <DefineStaticWebAssetEndpoints CandidateAssets="@(_CalculatorBrowserBuildDownloadManifestAsset)"
                                   ExistingEndpoints="@(StaticWebAssetEndpoint)"
                                   ContentTypeMappings="@(StaticWebAssetContentTypeMapping)">
      <Output TaskParameter="Endpoints" ItemName="_CalculatorBrowserBuildDownloadManifestEndpoint" />
    </DefineStaticWebAssetEndpoints>
    <ItemGroup>
      <StaticWebAsset Include="@(_CalculatorBrowserBuildDownloadManifestAsset)" />
      <StaticWebAssetEndpoint Include="@(_CalculatorBrowserBuildDownloadManifestEndpoint)" />
      <FileWrites Include="$(_CalculatorBrowserBuildDownloadManifestPath)" />
    </ItemGroup>
  </Target>

  <Target Name="GenerateCalculatorBrowserPublishDownloadManifest"
          AfterTargets="GeneratePublishWasmBootJson"
          Condition="'@(_WasmPublishAsset)' != ''">
    <PropertyGroup>
      <_CalculatorBrowserPublishDownloadManifestPath>$(IntermediateOutputPath)browser-asset-sizes.publish.js</_CalculatorBrowserPublishDownloadManifestPath>
    </PropertyGroup>
    <ItemGroup>
      <_CalculatorBrowserPublishDownloadManifestCandidate Include="$(_CalculatorBrowserPublishDownloadManifestPath)"
                                                          RelativePath="browser-asset-sizes.js" />
    </ItemGroup>
    <WriteLinesToFile File="$(_CalculatorBrowserPublishDownloadManifestPath)"
                      Lines="export const assetSizes = new Map(["
                      Overwrite="true"
                      Encoding="UTF-8" />
    <WriteLinesToFile File="$(_CalculatorBrowserPublishDownloadManifestPath)"
                      Lines="@(_WasmPublishAsset->'  [&quot;%(Filename)%(Extension)&quot;, %(FileLength)],')"
                      Overwrite="false"
                      Encoding="UTF-8" />
    <WriteLinesToFile File="$(_CalculatorBrowserPublishDownloadManifestPath)"
                      Lines="@(_WasmPublishAsset->'  [&quot;%(Filename).%(Fingerprint)%(Extension)&quot;, %(FileLength)],')"
                      Overwrite="false"
                      Encoding="UTF-8" />
    <WriteLinesToFile File="$(_CalculatorBrowserPublishDownloadManifestPath)"
                      Lines="]);"
                      Overwrite="false"
                      Encoding="UTF-8" />
    <DefineStaticWebAssets CandidateAssets="@(_CalculatorBrowserPublishDownloadManifestCandidate)"
                           SourceId="$(PackageId)"
                           SourceType="Computed"
                           AssetKind="Publish"
                           AssetRole="Primary"
                           CopyToOutputDirectory="Never"
                           CopyToPublishDirectory="PreserveNewest"
                           ContentRoot="$(PublishDir)wwwroot"
                           BasePath="$(StaticWebAssetBasePath)">
      <Output TaskParameter="Assets" ItemName="_CalculatorBrowserPublishDownloadManifestAsset" />
    </DefineStaticWebAssets>
    <DefineStaticWebAssetEndpoints CandidateAssets="@(_CalculatorBrowserPublishDownloadManifestAsset)"
                                   ExistingEndpoints="@(StaticWebAssetEndpoint)"
                                   ContentTypeMappings="@(StaticWebAssetContentTypeMapping)">
      <Output TaskParameter="Endpoints" ItemName="_CalculatorBrowserPublishDownloadManifestEndpoint" />
    </DefineStaticWebAssetEndpoints>
    <ItemGroup>
      <StaticWebAsset Include="@(_CalculatorBrowserPublishDownloadManifestAsset)" />
      <StaticWebAssetEndpoint Include="@(_CalculatorBrowserPublishDownloadManifestEndpoint)" />
      <FileWrites Include="$(_CalculatorBrowserPublishDownloadManifestPath)" />
    </ItemGroup>
  </Target>

</Project>
