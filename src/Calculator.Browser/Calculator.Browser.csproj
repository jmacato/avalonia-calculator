<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0-browser</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- .NET 10's interpreted threaded runtime attaches the browser UI thread
         without a pthread stack base and asserts before managed startup. Keep
         the managed-debuggable build single-threaded; Release remains AOT and
         uses the threaded compositor/runtime path. -->
    <WasmEnableThreads Condition="'$(Configuration)' == 'Release'">true</WasmEnableThreads>
    <WasmEnableThreads Condition="'$(Configuration)' != 'Release'">false</WasmEnableThreads>
    <EmccStackSize>1MB</EmccStackSize>
    <!-- Keep threaded runtime registration inside the initial allocation. The LLVM AOT
         payload crosses 84 MiB during startup; growing shared memory while worker
         instances are registering leaves those instances with stale bounds on WebKit. -->
    <WasmInitialHeapSize Condition="'$(Configuration)' == 'Release'">100663296</WasmInitialHeapSize>
    <EmccMaximumHeapSize Condition="'$(Configuration)' == 'Release'">209715200</EmccMaximumHeapSize>
    <InvariantTimezone>true</InvariantTimezone>
    <EventSourceSupport>true</EventSourceSupport>
    <RunAOTCompilation Condition="'$(Configuration)' == 'Release'">true</RunAOTCompilation>
    <!-- Local runs use identity assets. Compression is a publish concern and
         must not change how Debug or Release is served by dotnet run. -->
    <DisableBuildCompression>true</DisableBuildCompression>
    <EnableDefaultCompressionFormats>false</EnableDefaultCompressionFormats>
    <_WebAssemblyUserRunParameters>true</_WebAssemblyUserRunParameters>
    <_CalculatorBrowserHostProject>$([MSBuild]::NormalizePath($(MSBuildProjectDirectory), '..', '..', 'Tools', 'Calculator.BrowserHost', 'Calculator.BrowserHost.csproj'))</_CalculatorBrowserHostProject>
    <_CalculatorBrowserStaticWebAssetsManifest>$([MSBuild]::NormalizePath($(MSBuildProjectDirectory), 'bin', '$(Configuration)', '$(TargetFramework)', '$(AssemblyName).staticwebassets.runtime.json'))</_CalculatorBrowserStaticWebAssetsManifest>
    <RunCommand Condition="'$(DOTNET_HOST_PATH)' != '' and Exists('$(DOTNET_HOST_PATH)')">$(DOTNET_HOST_PATH)</RunCommand>
    <RunCommand Condition="'$(DOTNET_HOST_PATH)' == '' or !Exists('$(DOTNET_HOST_PATH)')">dotnet</RunCommand>
    <RunArguments>run --project &quot;$(_CalculatorBrowserHostProject)&quot; --configuration &quot;$(Configuration)&quot; --no-launch-profile -- &quot;$(_CalculatorBrowserStaticWebAssetsManifest)&quot;</RunArguments>
    <RunWorkingDirectory>$(MSBuildProjectDirectory)</RunWorkingDirectory>
    <!-- Several graph projects converge on the same vendored Avalonia projects.
         Serial project-reference builds prevent duplicate XAML compilers from
         rewriting the same output while dotnet run builds this entry point. -->
    <BuildInParallel>false</BuildInParallel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CollectAotProfile)' == 'true'">
    <RunAOTCompilation>false</RunAOTCompilation>
    <WasmEnableThreads>false</WasmEnableThreads>
    <WasmProfilers>aot</WasmProfilers>
    <EnableDiagnostics>false</EnableDiagnostics>
    <DefineConstants>$(DefineConstants);COLLECT_AOT_PROFILE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(CollectAotProfile)' != 'true'">
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <AOTMode>LLVMOnly</AOTMode>
    <WasmDedup>true</WasmDedup>
    <WasmStripILAfterAOT>true</WasmStripILAfterAOT>
    <WasmNativeDebugSymbols>false</WasmNativeDebugSymbols>
    <WasmNativeStrip>true</WasmNativeStrip>
    <WasmEmitSymbolMap>false</WasmEmitSymbolMap>
    <WasmEmitSourceMap>false</WasmEmitSourceMap>
    <WasmRunWasmOpt>true</WasmRunWasmOpt>
    <EmccCompileOptimizationFlag>-O3</EmccCompileOptimizationFlag>
    <WasmBitcodeCompileOptimizationFlag>-O3</WasmBitcodeCompileOptimizationFlag>
    <EmccLinkOptimizationFlag>-O3</EmccLinkOptimizationFlag>
    <EnableDiagnostics>false</EnableDiagnostics>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
    <!-- Preserve the native exception type, message, and WebAssembly stack when a
         pthread fails. Without this Emscripten surfaces only an opaque
         WebAssembly.Exception and the browser cannot report the failing runtime
         path to telemetry. This does not enable managed debugging. -->
    <EmccFlags>$(EmccFlags) -sEXCEPTION_STACK_TRACES=1</EmccFlags>
    <PublishCompressionFormats>brotli</PublishCompressionFormats>
    <CompressionIncludePatterns>$(CompressionIncludePatterns);**/*.ttf</CompressionIncludePatterns>
  </PropertyGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Release' and '$(CollectAotProfile)' != 'true'">
    <WasmOptConfigurationFlags Include="-O3" />
    <WasmOptConfigurationFlags Include="--merge-similar-functions" />
    <WasmOptConfigurationFlags Include="--duplicate-function-elimination" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Browser" Version="9999.0.0-localbuild" />
    <TrimmerRootDescriptor Include="ILLink.Descriptors.xml" Condition="'$(WasmEnableThreads)' == 'true'" />
    <NativeFileReference Include="Native/mono-aot-exception-diagnostics.c"
                         Condition="'$(Configuration)' == 'Release' and '$(CollectAotProfile)' != 'true'" />
    <EmccExportedFunction Include="_calc_browser_take_current_managed_exception"
                          Condition="'$(Configuration)' == 'Release' and '$(CollectAotProfile)' != 'true'" />
    <EmccExportedFunction Include="_calc_browser_load_configured_satellite"
                          Condition="'$(Configuration)' == 'Release' and '$(CollectAotProfile)' != 'true'" />
    <EmccExportedFunction Include="_calc_browser_get_satellite_load_status"
                          Condition="'$(Configuration)' == 'Release' and '$(CollectAotProfile)' != 'true'" />
    <NativeFileReference Include="Native/mono-aot-debugger-bootstrap.c"
                         Condition="'$(CalcEnableThreadedManagedDebugging)' == 'true'" />
    <_AOT_InternalForceInterpretAssemblies Include="Calculator"
                                           Condition="'$(CalcInterpretManagedDebugAssemblies)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Calculator\Calculator.csproj"
                      AdditionalProperties="CalculatorBrowserBuild=true;CalcEnableThreadedManagedDebugging=$(CalcEnableThreadedManagedDebugging)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Calculator\Assets\Fonts\Hind2\Hind2-Regular.ttf"
             Link="wwwroot\fonts\Hind2-Regular.ttf"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\Calculator\Assets\Fonts\Hind2\Hind2-SemiBold.ttf"
             Link="wwwroot\fonts\Hind2-SemiBold.ttf"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\Calculator\Assets\Fonts\Hind2\LICENSE.txt"
             Link="wwwroot\fonts\Hind2-LICENSE.txt"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="GenerateCalculatorBrowserBuildDownloadManifest"
          BeforeTargets="GenerateStaticWebAssetsManifest"
          DependsOnTargets="_AddWasmStaticWebAssets"
          Condition="'@(WasmStaticWebAsset)' != ''">
    <PropertyGroup>
      <_CalculatorBrowserBuildDownloadManifestPath>$(IntermediateOutputPath)browser-asset-sizes.build.js</_CalculatorBrowserBuildDownloadManifestPath>
    </PropertyGroup>
    <ItemGroup>
      <_CalculatorBrowserBuildDownloadAsset Include="@(WasmStaticWebAsset)"
                                            Condition="'%(AssetTraitName)' == 'WasmResource' or '%(AssetTraitName)' == 'Culture'" />
      <_CalculatorBrowserBuildDownloadManifestCandidate Include="$(_CalculatorBrowserBuildDownloadManifestPath)"
                                                        RelativePath="browser-asset-sizes.js" />
    </ItemGroup>
    <WriteLinesToFile File="$(_CalculatorBrowserBuildDownloadManifestPath)"
                      Lines="export const assetSizes = new Map(["
                      Overwrite="true"
                      Encoding="UTF-8" />
    <WriteLinesToFile File="$(_CalculatorBrowserBuildDownloadManifestPath)"
                      Lines="@(_CalculatorBrowserBuildDownloadAsset->'  [&quot;%(Filename)%(Extension)&quot;, %(FileLength)],')"
                      Overwrite="false"
                      Encoding="UTF-8" />
    <WriteLinesToFile File="$(_CalculatorBrowserBuildDownloadManifestPath)"
                      Lines="]);"
                      Overwrite="false"
                      Encoding="UTF-8" />
    <DefineStaticWebAssets CandidateAssets="@(_CalculatorBrowserBuildDownloadManifestCandidate)"
                           SourceId="$(PackageId)"
                           SourceType="Computed"
                           AssetKind="Build"
                           AssetRole="Primary"
                           CopyToOutputDirectory="PreserveNewest"
                           CopyToPublishDirectory="Never"
                           ContentRoot="$(OutDir)wwwroot"
                           BasePath="$(StaticWebAssetBasePath)">
      <Output TaskParameter="Assets" ItemName="_CalculatorBrowserBuildDownloadManifestAsset" />
    </DefineStaticWebAssets>
    <DefineStaticWebAssetEndpoints CandidateAssets="@(_CalculatorBrowserBuildDownloadManifestAsset)"
                                   ExistingEndpoints="@(StaticWebAssetEndpoint)"
                                   ContentTypeMappings="@(StaticWebAssetContentTypeMapping)">
      <Output TaskParameter="Endpoints" ItemName="_CalculatorBrowserBuildDownloadManifestEndpoint" />
    </DefineStaticWebAssetEndpoints>
    <ItemGroup>
      <StaticWebAsset Include="@(_CalculatorBrowserBuildDownloadManifestAsset)" />
      <StaticWebAssetEndpoint Include="@(_CalculatorBrowserBuildDownloadManifestEndpoint)" />
      <FileWrites Include="$(_CalculatorBrowserBuildDownloadManifestPath)" />
    </ItemGroup>
  </Target>

  <Target Name="GenerateCalculatorBrowserPublishDownloadManifest"
          AfterTargets="GeneratePublishWasmBootJson"
          Condition="'@(_WasmPublishAsset)' != ''">
    <PropertyGroup>
      <_CalculatorBrowserPublishDownloadManifestPath>$(IntermediateOutputPath)browser-asset-sizes.publish.js</_CalculatorBrowserPublishDownloadManifestPath>
    </PropertyGroup>
    <ItemGroup>
      <_CalculatorBrowserPublishDownloadManifestCandidate Include="$(_CalculatorBrowserPublishDownloadManifestPath)"
                                                          RelativePath="browser-asset-sizes.js" />
    </ItemGroup>
    <WriteLinesToFile File="$(_CalculatorBrowserPublishDownloadManifestPath)"
                      Lines="export const assetSizes = new Map(["
                      Overwrite="true"
                      Encoding="UTF-8" />
    <WriteLinesToFile File="$(_CalculatorBrowserPublishDownloadManifestPath)"
                      Lines="@(_WasmPublishAsset->'  [&quot;%(Filename)%(Extension)&quot;, %(FileLength)],')"
                      Overwrite="false"
                      Encoding="UTF-8" />
    <WriteLinesToFile File="$(_CalculatorBrowserPublishDownloadManifestPath)"
                      Lines="@(_WasmPublishAsset->'  [&quot;%(Filename).%(Fingerprint)%(Extension)&quot;, %(FileLength)],')"
                      Overwrite="false"
                      Encoding="UTF-8" />
    <WriteLinesToFile File="$(_CalculatorBrowserPublishDownloadManifestPath)"
                      Lines="]);"
                      Overwrite="false"
                      Encoding="UTF-8" />
    <DefineStaticWebAssets CandidateAssets="@(_CalculatorBrowserPublishDownloadManifestCandidate)"
                           SourceId="$(PackageId)"
                           SourceType="Computed"
                           AssetKind="Publish"
                           AssetRole="Primary"
                           CopyToOutputDirectory="Never"
                           CopyToPublishDirectory="PreserveNewest"
                           ContentRoot="$(PublishDir)wwwroot"
                           BasePath="$(StaticWebAssetBasePath)">
      <Output TaskParameter="Assets" ItemName="_CalculatorBrowserPublishDownloadManifestAsset" />
    </DefineStaticWebAssets>
    <DefineStaticWebAssetEndpoints CandidateAssets="@(_CalculatorBrowserPublishDownloadManifestAsset)"
                                   ExistingEndpoints="@(StaticWebAssetEndpoint)"
                                   ContentTypeMappings="@(StaticWebAssetContentTypeMapping)">
      <Output TaskParameter="Endpoints" ItemName="_CalculatorBrowserPublishDownloadManifestEndpoint" />
    </DefineStaticWebAssetEndpoints>
    <ItemGroup>
      <StaticWebAsset Include="@(_CalculatorBrowserPublishDownloadManifestAsset)" />
      <StaticWebAssetEndpoint Include="@(_CalculatorBrowserPublishDownloadManifestEndpoint)" />
      <FileWrites Include="$(_CalculatorBrowserPublishDownloadManifestPath)" />
    </ItemGroup>
  </Target>

  <Target Name="PatchCalculatorNativeBrowserRuntime"
          AfterTargets="WasmLinkDotNet"
          BeforeTargets="_CompleteWasmBuildNative"
          Condition="'$(Configuration)' == 'Release' and '$(CollectAotProfile)' != 'true'">
    <PropertyGroup>
      <_CalculatorNativeWorkerPath>$(_WasmIntermediateOutputPath)dotnet.native.worker.mjs</_CalculatorNativeWorkerPath>
      <_CalculatorEmscriptenNode>$([MSBuild]::NormalizePath($(EmscriptenNodeToolsPath), 'bin', 'node$(_ExeExt)'))</_CalculatorEmscriptenNode>
      <_CalculatorNativeWorkerPatch>$([MSBuild]::NormalizePath($(MSBuildProjectDirectory), '..', '..', 'eng', 'browser', 'patch-dotnet-native-worker.mjs'))</_CalculatorNativeWorkerPatch>
    </PropertyGroup>
    <Exec Command="&quot;$(_CalculatorEmscriptenNode)&quot; &quot;$(_CalculatorNativeWorkerPatch)&quot; &quot;$(_CalculatorNativeWorkerPath)&quot;"
          Condition="Exists('$(_CalculatorNativeWorkerPath)')" />
  </Target>

  <Target Name="ProjectCalculatorBrotliOnlyPublish"
          AfterTargets="Publish"
          Condition="'$(Configuration)' == 'Release' and '$(CollectAotProfile)' != 'true'">
    <PropertyGroup>
      <_CalculatorEmscriptenNode>$([MSBuild]::NormalizePath($(EmscriptenNodeToolsPath), 'bin', 'node$(_ExeExt)'))</_CalculatorEmscriptenNode>
      <_CalculatorRuntimePatch>$([MSBuild]::NormalizePath($(MSBuildProjectDirectory), '..', '..', 'eng', 'browser', 'patch-dotnet-runtime-worker-preload.mjs'))</_CalculatorRuntimePatch>
    </PropertyGroup>
    <ItemGroup>
      <_CalculatorBrotliSidecar Include="$(PublishDir)wwwroot/**/*.br" />
      <_CalculatorBrotliRuntimeSidecar Include="$(PublishDir)wwwroot/_framework/dotnet.runtime*.js.br" />
      <_CalculatorRawAssetWithBrotli Include="@(_CalculatorBrotliSidecar->'%(RootDir)%(Directory)%(Filename)')" />
      <_CalculatorObsoleteGzipSidecar Include="$(PublishDir)wwwroot/**/*.gz" />
    </ItemGroup>
    <Exec Command="&quot;$(_CalculatorEmscriptenNode)&quot; &quot;$(_CalculatorRuntimePatch)&quot; &quot;%(_CalculatorBrotliRuntimeSidecar.FullPath)&quot;"
          Condition="'@(_CalculatorBrotliRuntimeSidecar)' != ''" />
    <Delete Files="@(_CalculatorRawAssetWithBrotli);@(_CalculatorObsoleteGzipSidecar)" />
  </Target>
</Project>
