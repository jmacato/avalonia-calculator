<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <AssemblyName>Calculator.LegacyUI</AssemblyName>
    <RootNamespace>Calculator.LegacyUI</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- This is a compile-time owner for retained WinUI-era sources.  The
         repository builds it on non-Windows hosts, so Windows-only XAML and
         PRI generation are intentionally not part of this class library. -->
    <UseUwpTools>true</UseUwpTools>
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
    <AppxGeneratePrisForPortableLibrariesEnabled>false</AppxGeneratePrisForPortableLibrariesEnabled>
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Calculator\Common\**\*.cs"
             Exclude="..\Calculator\Common\KeyboardShortcutManager*.cs;..\Calculator\Common\LaunchExtensions.LaunchArguments.cs;..\Calculator\Common\SnapshotLaunchArguments.LaunchArguments.cs" />
    <Compile Include="..\Calculator\Converters\**\*.cs"
             Exclude="..\Calculator\Converters\ExpressionItemTemplateSelector.cs" />
    <Compile Include="..\Calculator\Utils\**\*.cs"
             Exclude="..\Calculator\Utils\*JsonUtils.cs;..\Calculator\Utils\DeflateUtils.cs;..\Calculator\Utils\DelegateCommandUtils.cs;..\Calculator\Utils\ResourceString.cs;..\Calculator\Utils\ResourceVirtualKey.cs" />
    <Compile Include="..\Calculator\IDataTransferManagerInterop.UWPToWinAppSDKUpgradeHelpers.cs" />
    <Compile Include="..\Calculator\WindowFrameService.cs" />
    <Compile Include="..\Calculator\Views\StateTriggers\**\*.cs" />
    <Compile Include="..\Calculator\ViewModels\Common\*ExpressionCommandDeserializer*.cs" />
    <Compile Include="..\Calculator\ViewModels\Common\*ExpressionCommandSerializer*.cs" />
    <Compile Include="..\Calculator\ViewModels\Common\*AppResourceProvider*.cs" />
    <Compile Include="..\Calculator\ViewModels\Common\*LocalizationService*.cs" />
    <Compile Include="..\Calculator\ViewModels\Common\LocalizationSettings.h.cs" />
    <Compile Include="..\Calculator\ViewModels\Common\RadixType.*.cs" />
    <Compile Include="..\Calculator\ViewModels\Common\Utilities.cs" />
    <Compile Include="..\Calculator\ViewModels\Common\WinNativeMethods.Utilities.cs" />
    <Compile Include="..\Calculator\ViewModels\GraphingCalculator\GraphingControlStub\**\*.cs" />
    <Compile Include="App.cs" />
    <Compile Include="CompatibilityTypeRoots.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Common" Version="8.4.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260710003" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CalcManagerManaged\CalcManagerPort\CalcManagerPort.csproj" />
  </ItemGroup>
</Project>
